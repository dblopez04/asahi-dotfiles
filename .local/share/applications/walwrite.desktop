[Desktop Entry]
Type=Application
Name=Walwrite
GenericName=Markdown Editor
Comment=Simple Markdown and text editor in the pywal colors
Exec=walwrite %F
Icon=accessories-text-editor
Terminal=false
Categories=Office;TextEditor;
MimeType=text/markdown;text/x-markdown;text/plain;
Keywords=markdown;write;notes;text;editor;
StartupWMClass=dev.dotfiles.walwrite
