# Regenerated from the pywal colors by wal.sh (and install.sh) on every theme change
.config/gtk-4.0/gtk.css
.config/gtk-4.0/gtk-dark.css

# Neovim help index, rebuilt automatically
.config/nvim/doc/tags

# Python bytecode (scripts/, scripts/settings_pages/)
__pycache__/
*.pyc

# Config backups and unsaved changes from the settings panel
backups/
.config/sway/settings.conf
# temp files dotconfig.py writes then renames (only left behind if it's killed mid-write)
.config/sway/.check-*
.settings-*

# Local Claude Code settings (also in the global git ignore on this machine)
.claude/settings.local.json
