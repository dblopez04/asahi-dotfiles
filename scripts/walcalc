#!/usr/bin/env python3
# Walcalc: a dead-simple calculator in the pywal colors, after Omarchy's Omacalc
# (github.com/omacom/omacalc). Same keypad, keyboard keys, and calculator behavior.

import json
import math
import os
import sys

import gi

gi.require_version("Gdk", "4.0")
gi.require_version("Gtk", "4.0")
from gi.repository import Gdk, Gio, GLib, Gtk, Pango  # noqa: E402

APP_NAME = "walcalc"
WAL_DIR = os.path.expanduser("~/.cache/wal")
STATE_FILE = os.path.join(GLib.get_user_state_dir(), APP_NAME, "state.json")
FONT_FAMILY = "BlexMono Nerd Font"
DESIGN_WIDTH, DESIGN_HEIGHT = 400, 568

PLUS, MINUS, TIMES, DIVIDE = "+", "−", "×", "÷"
OPERATORS = (PLUS, MINUS, TIMES, DIVIDE)


# ---------- calculator ----------

def format_number(value):
    # 15 significant digits keeps float noise like 0.1 + 0.2 out of the display
    if value == 0:
        value = 0.0  # collapse negative zero
    return "%.15g" % value


def parse_number(text):
    try:
        value = float(text)
    except ValueError:
        return None
    return value if math.isfinite(value) else None


def seal_number(entry):
    # digits are entered raw, so "5." and "-" can linger while typing
    if entry.endswith("."):
        entry = entry[:-1]
    return "0" if entry in ("", "-") else entry


def evaluate_tokens(tokens):
    """[number, op, number, ...] with × and ÷ before + and −; None on error."""
    if len(tokens) % 2 == 0:
        return None
    first = parse_number(tokens[0])
    if first is None:
        return None
    values, additive = [first], []
    for op, operand in zip(tokens[1::2], tokens[2::2]):
        number = parse_number(operand)
        if number is None or op not in OPERATORS:
            return None
        if op == TIMES:
            values[-1] *= number
        elif op == DIVIDE:
            if number == 0:
                return None
            values[-1] /= number
        else:
            additive.append(op)
            values.append(number)
    total = values[0]
    for op, number in zip(additive, values[1:]):
        total = total + number if op == PLUS else total - number
    return total if math.isfinite(total) else None


def pretty_expression(tokens):
    return " ".join(t if t in OPERATORS else format_number(float(t)) for t in tokens)


class Calculator:
    def __init__(self):
        self.tokens = []
        self.entry = ""
        self.result = ""
        self.result_value = 0.0
        self.evaluated_expression = ""
        self.just_evaluated = False
        self.errored = False

    def expression(self):
        if self.errored or self.just_evaluated:
            return self.evaluated_expression
        return pretty_expression(self.tokens)

    def display(self):
        if self.errored:
            return "Error"
        if self.entry:
            return self.entry
        if self.just_evaluated:
            return self.result
        return format_number(float(self.current_value()))

    def current_value(self):
        # the entry being typed, or the operand the last operator applies to, or zero
        if self.entry:
            return seal_number(self.entry)
        for token in reversed(self.tokens):
            if token not in OPERATORS:
                return token
        return "0"

    def press(self, key):
        if len(key) == 1 and key.isdigit():
            self._digit(key)
        elif key == ".":
            self._decimal()
        elif key == "+":
            self._operator(PLUS)
        elif key in ("-", MINUS):
            self._operator(MINUS)
        elif key in ("*", TIMES):
            self._operator(TIMES)
        elif key in ("/", DIVIDE):
            self._operator(DIVIDE)
        elif key == "=":
            self._equals()
        elif key == "%":
            self._percent()
        elif key == "sign":
            self._toggle_sign()
        elif key == "backspace":
            self._backspace()
        elif key == "clear":
            self.clear()

    def _digit(self, digit):
        # a digit after an error or equals starts a new calculation
        if self.errored or self.just_evaluated:
            self.clear()
        if self.entry == "0":
            self.entry = digit
            return
        if self.entry == "-0":
            self.entry = "-" + digit
            return
        # 15 significant digits is what the display keeps; the zero in "0." doesn't count
        digits = sum(c.isdigit() for c in self.entry)
        if self.entry.startswith(("0.", "-0.")):
            digits -= 1
        if digits < 15:
            self.entry += digit

    def _decimal(self):
        if self.errored or self.just_evaluated:
            self.clear()
        if not self.entry:
            self.entry = "0."
        elif "." not in self.entry:
            self.entry += "."

    def _operator(self, op):
        if self.errored:
            return
        if self.just_evaluated:
            # chain from the exact value so 1 ÷ 3 = × 3 comes back as 1
            self.tokens = ["%.17g" % self.result_value]
            self._clear_evaluation()
        if self.entry:
            self.tokens += [seal_number(self.entry), op]
            self.entry = ""
        elif not self.tokens:
            self.tokens = ["0", op]
        elif self.tokens[-1] in OPERATORS:
            self.tokens[-1] = op
        else:
            self.tokens.append(op)

    def _equals(self):
        if self.errored or self.just_evaluated:
            return
        final = self.tokens + ([seal_number(self.entry)] if self.entry else [])
        while final and final[-1] in OPERATORS:
            final.pop()
        if not final:
            return
        self.evaluated_expression = pretty_expression(final)
        value = evaluate_tokens(final)
        if value is None:
            self.errored = True
        else:
            self.result_value = value
            self.result = format_number(value)
            self.just_evaluated = True
        self.tokens = []
        self.entry = ""

    def _percent(self):
        # with a pending + or −, x% is x percent of the running total (200 + 10 % = 220);
        # with × or ÷, or on its own, it's x ÷ 100
        if self.errored:
            return
        if self.just_evaluated:
            percent = self.result_value / 100
            self._clear_evaluation()
            self.entry = format_number(percent)
            return
        value = parse_number(self.current_value())
        if value is None:
            return
        percent = value / 100
        if self.tokens and self.tokens[-1] in (PLUS, MINUS):
            base = evaluate_tokens(self.tokens[:-1])
            if base is not None:
                percent = base * value / 100
        self.entry = format_number(percent)

    def _toggle_sign(self):
        if self.errored:
            return
        if self.just_evaluated:
            self._begin_editing_after_result()
        # with nothing typed, start a fresh negative operand: 4 + ± 2 enters -2
        if not self.entry:
            self.entry = "-0"
        elif self.entry.startswith("-"):
            self.entry = self.entry[1:]
        else:
            self.entry = "-" + self.entry

    def _backspace(self):
        if self.errored:
            self.clear()
            return
        if self.just_evaluated:
            self._begin_editing_after_result()
        self.entry = self.entry[:-1]
        if self.entry == "-":
            self.entry = ""

    def clear(self):
        self.tokens = []
        self.entry = ""
        self._clear_evaluation()
        self.errored = False

    def _begin_editing_after_result(self):
        self.entry = self.result
        self.tokens = []
        self._clear_evaluation()

    def _clear_evaluation(self):
        self.result = ""
        self.result_value = 0.0
        self.evaluated_expression = ""
        self.just_evaluated = False

    def paste(self, text):
        # accepts surrounding whitespace, a decimal comma, and the typographic minus
        text = text.strip().replace(MINUS, "-").replace(" ", "")
        if "_" in text:
            return False
        value = parse_number(text)
        if value is None:
            value = parse_number(text.replace(",", "."))
        if value is None:
            return False
        if self.errored or self.just_evaluated:
            self.clear()
        self.entry = format_number(value)
        return True


# ---------- theme ----------

def load_palette():
    palette = {"background": "#101010", "foreground": "#eeeeee", "accent": "#5584aa"}
    try:
        with open(os.path.join(WAL_DIR, "colors.json")) as f:
            colors = json.load(f)
        palette["background"] = colors["special"]["background"]
        palette["foreground"] = colors["special"]["foreground"]
        palette["accent"] = colors["colors"]["color1"]  # fuzzel's selection and border color
    except (OSError, ValueError, KeyError):
        pass
    return palette


def mix(base, tint, amount):
    a = [int(base[i:i + 2], 16) for i in (1, 3, 5)]
    b = [int(tint[i:i + 2], 16) for i in (1, 3, 5)]
    return "#%02x%02x%02x" % tuple(round(x + (y - x) * amount) for x, y in zip(a, b))


def theme_css(p):
    bg, fg, accent = p["background"], p["foreground"], p["accent"]
    return f"""
window.walcalc {{ background-color: {bg}; color: {fg}; }}
.walcalc label {{ font-family: "{FONT_FAMILY}", monospace; color: {fg}; }}
.walcalc .expression {{ color: {mix(bg, fg, 0.5)}; }}
.walcalc .display {{ border-bottom: 1px solid {mix(bg, fg, 0.16)}; }}
.walcalc button.key {{
    border-radius: 0; box-shadow: none; text-shadow: none; background-image: none;
    outline: none; transition: none; min-width: 0; min-height: 0; padding: 0;
    border: 1px solid transparent;
}}
.walcalc button.number {{ background-color: {mix(bg, fg, 0.05)}; border-color: {mix(bg, fg, 0.13)}; }}
.walcalc button.number:hover {{ background-color: {mix(bg, fg, 0.095)}; }}
.walcalc button.number:active {{ background-color: {mix(bg, fg, 0.14)}; }}
.walcalc button.operator {{ background-color: {mix(bg, fg, 0.16)}; }}
.walcalc button.operator:hover {{ background-color: {mix(bg, fg, 0.205)}; }}
.walcalc button.operator:active {{ background-color: {mix(bg, fg, 0.25)}; }}
.walcalc button.equals {{ background-color: {accent}; border-color: {accent}; }}
.walcalc button.equals:hover {{ background-color: {mix(accent, fg, 0.1)}; }}
.walcalc button.equals:active {{ background-color: {mix(accent, fg, 0.22)}; }}
.walcalc button.equals label {{ color: {bg}; }}
"""


def set_font_px(label, px):
    attrs = Pango.AttrList()
    attrs.insert(Pango.attr_size_new_absolute(int(px * Pango.SCALE)))
    label.set_attributes(attrs)


# ---------- window ----------

KEYPAD = [
    ("AC", "clear", "number"), ("±", "sign", "number"), ("%", "%", "number"), (DIVIDE, DIVIDE, "operator"),
    ("7", "7", "number"), ("8", "8", "number"), ("9", "9", "number"), (TIMES, TIMES, "operator"),
    ("4", "4", "number"), ("5", "5", "number"), ("6", "6", "number"), (MINUS, "-", "operator"),
    ("1", "1", "number"), ("2", "2", "number"), ("3", "3", "number"), ("+", "+", "operator"),
    ("0", "0", "number"), (".", ".", "number"), ("", "backspace", "number"), ("=", "=", "equals"),
]


class CalcWindow(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Walcalc")
        self.set_decorated(False)
        self.add_css_class("walcalc")
        self.calc = Calculator()
        self.palette = load_palette()
        self.size = (DESIGN_WIDTH, DESIGN_HEIGHT)

        state = self._read_state()
        self.set_default_size(state.get("width", DESIGN_WIDTH), state.get("height", DESIGN_HEIGHT))

        self.css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), self.css, Gtk.STYLE_PROVIDER_PRIORITY_USER + 100)
        self._load_css()

        overlay = Gtk.Overlay()
        self.set_child(overlay)
        # an empty drawing area underneath reports the window size so the face scales with it
        sizer = Gtk.DrawingArea()
        sizer.set_size_request(300, 430)
        sizer.connect("resize", lambda _area, w, h: self._rescale(w, h))
        overlay.set_child(sizer)

        self.face = Gtk.Grid(row_homogeneous=True, column_homogeneous=True)
        overlay.add_overlay(self.face)

        display = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        display.add_css_class("display")
        self.display = display
        self.expression_label = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.START)
        self.expression_label.add_css_class("expression")
        self.result_label = Gtk.Label(xalign=1, vexpand=True, valign=Gtk.Align.END,
                                      ellipsize=Pango.EllipsizeMode.START)
        self.result_label.add_css_class("result")
        display.append(self.expression_label)
        display.append(self.result_label)
        # the display takes 32% of the face and the keypad 68%, as in Omacalc
        self.face.attach(display, 0, 0, 1, 8)

        self.keypad = Gtk.Grid(row_homogeneous=True, column_homogeneous=True)
        self.face.attach(self.keypad, 0, 8, 1, 17)
        self.key_labels = []
        for index, (label, key, kind) in enumerate(KEYPAD):
            button = Gtk.Button(focusable=False, focus_on_click=False)
            button.add_css_class("key")
            button.add_css_class(kind)
            if key == "backspace":
                icon = self._backspace_icon()
                if isinstance(icon, Gtk.Label):
                    self.key_labels.append(icon)
                button.set_child(icon)
                button.set_tooltip_text("Backspace")
            else:
                text = Gtk.Label(label=label)
                button.set_child(text)
                self.key_labels.append(text)
            button.connect("clicked", lambda _b, k=key: self._press(k))
            self.keypad.attach(button, index % 4, index // 4, 1, 1)

        keys = Gtk.EventControllerKey()
        keys.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self._on_key)
        self.add_controller(keys)
        self.connect("close-request", self._on_close)

        # re-tint live when wal writes a new colors.json
        self.theme_monitor = Gio.File.new_for_path(WAL_DIR).monitor_directory(Gio.FileMonitorFlags.NONE, None)
        self.theme_monitor.connect("changed", self._on_wal_changed)
        self._theme_timeout = 0

        self._refresh()

    def _backspace_icon(self):
        try:
            gi.require_foreign("cairo")
        except ImportError:
            return Gtk.Label(label="⌫")
        self.backspace_area = Gtk.DrawingArea()
        self.backspace_area.set_draw_func(self._draw_backspace)
        return self.backspace_area

    def _draw_backspace(self, _area, cr, width, height):
        # a key cap whose left edge tapers to a point, with an x inside
        size = min(height * 0.42, width * 0.3)
        w = size * 1.3
        h = w * 0.72
        x0, y0 = (width - w) / 2, (height - h) / 2
        notch = w * 0.28
        fg = self.palette["foreground"]
        cr.set_source_rgb(*(int(fg[i:i + 2], 16) / 255 for i in (1, 3, 5)))
        cr.set_line_width(max(1.4, w * 0.07))
        cr.set_line_cap(1)  # round
        cr.set_line_join(1)  # round
        cr.move_to(x0 + notch, y0 + 1)
        cr.line_to(x0 + w - 1, y0 + 1)
        cr.line_to(x0 + w - 1, y0 + h - 1)
        cr.line_to(x0 + notch, y0 + h - 1)
        cr.line_to(x0 + 1, y0 + h / 2)
        cr.close_path()
        cr.stroke()
        cx, cy, arm = x0 + notch + (w - notch) / 2, y0 + h / 2, h * 0.18
        cr.move_to(cx - arm, cy - arm)
        cr.line_to(cx + arm, cy + arm)
        cr.move_to(cx + arm, cy - arm)
        cr.line_to(cx - arm, cy + arm)
        cr.stroke()

    # every size is expressed at the 400 × 568 design size and scales with the window
    def _rescale(self, width, height):
        self.size = (width, height)
        s = min(width / DESIGN_WIDTH, height / DESIGN_HEIGHT)
        self.scale = s
        margin = max(1, round(20 * s))
        for side in ("start", "end", "top", "bottom"):
            getattr(self.face, f"set_margin_{side}")(margin)
        spacing = max(1, round(12 * s))
        self.keypad.set_row_spacing(spacing)
        self.keypad.set_column_spacing(spacing)
        self.display.set_margin_bottom(round(22 * s))
        self.result_label.set_margin_bottom(round(24 * s))
        for label in (self.expression_label, self.result_label):
            label.set_margin_start(round(8 * s))
            label.set_margin_end(round(8 * s))
        set_font_px(self.expression_label, max(1, 21 * s))

        face_w, face_h = width - 2 * margin, height - 2 * margin
        key_w = (face_w - 3 * spacing) / 4
        key_h = (face_h * 0.68 - 4 * spacing) / 5
        key_px = max(1, min(key_h * 0.42, key_w * 0.3))
        for label in self.key_labels:
            set_font_px(label, key_px)
        self.face_width = face_w
        self.display_height = face_h * 8 / 25
        self._fit_result()

    def _fit_result(self):
        # shrink the result to fit the width (Plex Mono glyphs are 0.6em wide), and keep the
        # display's text within its 32% share so the keypad isn't pushed past the window edge
        s = getattr(self, "scale", 1)
        available = getattr(self, "face_width", DESIGN_WIDTH - 40) - 16 * s
        text = self.result_label.get_text() or "0"
        line = 1.35  # label height per pixel of font size
        room = getattr(self, "display_height", 169) - 46 * s - 21 * s * line
        px = min(76 * s, available / (len(text) * 0.6), room / line)
        set_font_px(self.result_label, max(px, 1))

    def _refresh(self):
        self.expression_label.set_text(self.calc.expression())
        self.result_label.set_text(self.calc.display())
        self._fit_result()

    def _press(self, key):
        self.calc.press(key)
        self._refresh()

    def _on_key(self, _controller, keyval, _keycode, state):
        command = state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.SUPER_MASK | Gdk.ModifierType.META_MASK)
        lower = Gdk.keyval_to_lower(keyval)
        if command:
            if lower == Gdk.KEY_c:
                self.get_clipboard().set_content(Gdk.ContentProvider.new_for_value(self.calc.display()))
                return True
            if lower == Gdk.KEY_v:
                self.get_clipboard().read_text_async(None, self._on_paste)
                return True
            if lower == Gdk.KEY_q and state & Gdk.ModifierType.CONTROL_MASK:
                self.close()
                return True
            return False
        if state & Gdk.ModifierType.ALT_MASK:
            return False

        char = chr(Gdk.keyval_to_unicode(keyval) or 0)
        if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) or char == "=":
            self._press("=")
        elif keyval == Gdk.KEY_BackSpace:
            self._press("backspace")
        elif keyval in (Gdk.KEY_Escape, Gdk.KEY_Delete) or char in ("c", "C"):
            self._press("clear")
        elif char in (",", "."):
            self._press(".")
        elif char in ("s", "S"):
            self._press("sign")
        elif char and char in "0123456789+-*/%":
            self._press(char)
        else:
            return False
        return True

    def _on_paste(self, clipboard, result):
        try:
            text = clipboard.read_text_finish(result)
        except GLib.Error:
            return
        if text and self.calc.paste(text):
            self._refresh()

    def _load_css(self):
        self.css.load_from_string(theme_css(self.palette))

    def _on_wal_changed(self, _monitor, file, _other, _event):
        if file.get_basename() != "colors.json":
            return
        if self._theme_timeout:
            GLib.source_remove(self._theme_timeout)
        self._theme_timeout = GLib.timeout_add(150, self._reload_theme)

    def _reload_theme(self):
        self._theme_timeout = 0
        self.palette = load_palette()
        self._load_css()
        if hasattr(self, "backspace_area"):
            self.backspace_area.queue_draw()
        return False

    def _read_state(self):
        try:
            with open(STATE_FILE) as f:
                return json.load(f)
        except (OSError, ValueError):
            return {}

    def _on_close(self, _window):
        if not (self.is_maximized() or self.is_fullscreen()):
            try:
                os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
                with open(STATE_FILE, "w") as f:
                    json.dump({"width": self.get_width(), "height": self.get_height()}, f)
            except OSError:
                pass
        return False


def main():
    GLib.set_prgname(APP_NAME)  # becomes the Wayland app_id that sway's floating rule matches
    Gtk.Window.set_default_icon_name("accessories-calculator")
    app = Gtk.Application(flags=Gio.ApplicationFlags.NON_UNIQUE)
    app.connect("activate", lambda app: CalcWindow(app).present())
    return app.run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())
