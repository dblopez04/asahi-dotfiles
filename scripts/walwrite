def preview_css(p, font_size):
    bg, fg, accent = p["background"], p["foreground"], p["accent"]
    muted, line, raised = mix(bg, fg, 0.5), mix(bg, fg, 0.15), mix(bg, fg, 0.06)
    px = round(font_size * 4 / 3)
    return f"""
html {{ background: {bg}; color: {fg}; }}
body {{ font-family: "{FONT_FAMILY}", monospace; font-size: {px}px; line-height: 1.65;
       max-width: 70ch; margin: 0 auto; padding: 42px 28px 200px 28px; overflow-wrap: anywhere; }}
h1, h2, h3, h4, h5, h6 {{ line-height: 1.3; margin: 1.4em 0 0.5em 0; }}
h1 {{ font-size: 1.7em; }} h2 {{ font-size: 1.4em; }} h3 {{ font-size: 1.2em; }}
h1, h2 {{ border-bottom: 1px solid {line}; padding-bottom: 0.2em; }}
body > :first-child {{ margin-top: 0; }}
a {{ color: {accent}; }}
code {{ background: {raised}; padding: 0.1em 0.3em; font-size: 0.92em; }}
pre {{ background: {raised}; padding: 12px 14px; overflow-x: auto; border-left: 2px solid {line}; }}
pre code {{ background: none; padding: 0; }}
blockquote {{ margin: 0; padding: 0 1em; color: {muted}; border-left: 2px solid {accent}; }}
hr {{ border: none; border-top: 1px solid {line}; margin: 2em 0; }}
table {{ border-collapse: collapse; margin: 1em 0; }}
th, td {{ border: 1px solid {line}; padding: 4px 10px; }}
th {{ background: {raised}; }}
img {{ max-width: 100%; }}
ul, ol {{ padding-left: 1.6em; }}
li > input[type=checkbox] {{ margin-right: 0.4em; accent-color: {accent}; }}
::selection {{ background: {accent}; color: {bg}; }}
"""


def choice_dialog(parent, title, body, buttons, on_response, focus=None):
    """A square, themed modal. buttons: (label, response, primary, sensitive)."""
    dialog = Gtk.Window(transient_for=parent, modal=True, decorated=False, resizable=False, title=title)
    dialog.add_css_class("walwrite-dialog")
    done = []

    def respond(response):
        if not done:
            done.append(response)
            dialog.destroy()
            on_response(response)

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
    for side in ("start", "end", "top", "bottom"):
        getattr(box, f"set_margin_{side}")(20)
    heading = Gtk.Label(label=title, xalign=0)
    heading.add_css_class("dialog-title")
    text = Gtk.Label(label=body, xalign=0, wrap=True, max_width_chars=60)
    text.add_css_class("dialog-body")
    row = Gtk.Box(spacing=8, halign=Gtk.Align.END, margin_top=8)
    widgets = {}
    for label, response, primary, sensitive in buttons:
        button = Gtk.Button(label=label, sensitive=sensitive)
        button.add_css_class("square")
        if primary:
            button.add_css_class("primary")
        button.connect("clicked", lambda _b, r=response: respond(r))
        row.append(button)
        widgets[response] = button
    box.append(heading)
    box.append(text)
    box.append(row)
    dialog.set_child(box)

    keys = Gtk.EventControllerKey()
    keys.connect("key-pressed", lambda _c, keyval, _k, _s: keyval == Gdk.KEY_Escape and (respond("cancel") or True))
    dialog.add_controller(keys)
    dialog.connect("close-request", lambda _w: respond("cancel") or True)
    dialog.present()
    if focus in widgets:
        widgets[focus].grab_focus()
    return dialog


# ---------- documents ----------

class Document:
    """One open file (or untitled draft): its buffer, highlighting, saving and outside changes.

    The window owns the widgets; a document calls window.document_changed(self) when its title,
    modified state or status line should be redrawn.
    """

    def __init__(self, window, tag_table, path=None, draft_id=None):
        self.window = window
        self.buffer = Gtk.TextBuffer(tag_table=tag_table)
        self.buffer.set_enable_undo(True)
        self.path = os.path.abspath(path) if path else None
        self.draft_id = draft_id or uuid.uuid4().hex
        self.modified = False
        self.loading = False
        self.status = ""
        self.known_contents = None  # what the file held when we last read or wrote it
        self.monitor = None
        self.external_dialog = None
        self.cursor = 0
        self.scroll = 0.0
        self._timeouts = {}
        self._dirty_lines = None
        self._highlight_source = 0
        self.buffer.connect("changed", self._on_changed)
        self.buffer.connect_after("insert-text", self._on_insert_text)
        self.buffer.connect_after("delete-range", self._on_delete_range)
        self.buffer.connect("notify::cursor-position", lambda *_: self._remember_cursor())

    # ----- names -----

    def name(self):
        return os.path.basename(self.path) if self.path else self.untitled_name()

    def untitled_name(self):
        first = self.text().split("\n", 1)[0].strip().lstrip("#").strip()
        return (first[:40] or "Untitled") if not self.path else ""

    def text(self):
        start, end = self.buffer.get_bounds()
        return self.buffer.get_text(start, end, True)

    def is_empty_untitled(self):
        return not self.path and self.buffer.get_char_count() == 0

    # ----- timers -----

    def debounce(self, name, ms, callback):
        self.cancel(name)

        def fire():
            self._timeouts[name] = 0
            callback()
            return False

        self._timeouts[name] = GLib.timeout_add(ms, fire)

    def cancel(self, name):
        if self._timeouts.get(name):
            GLib.source_remove(self._timeouts[name])
            self._timeouts[name] = 0

    def dispose(self):
        for name in list(self._timeouts):
            self.cancel(name)
        if self._highlight_source:
            GLib.source_remove(self._highlight_source)
            self._highlight_source = 0
        self.unwatch()
        if self.external_dialog:
            self.external_dialog.destroy()

    # ----- loading and editing -----

    def set_text(self, text, modified=False):
        self.loading = True
        self.buffer.begin_irreversible_action()
        self.buffer.set_text(text)
        self.buffer.end_irreversible_action()
        self.buffer.place_cursor(self.buffer.get_start_iter())
        self.loading = False
        self.highlight(full=True)
        self.set_modified(modified)

    def _remember_cursor(self):
        self.cursor = self.buffer.get_iter_at_mark(self.buffer.get_insert()).get_offset()

    def set_modified(self, modified):
        if self.modified != modified:
            self.modified = modified
        self.window.document_changed(self)

    def set_status(self, status):
        self.status = status
        self.window.document_changed(self)

    def _on_changed(self, _buffer):
        if self.loading:
            return
        self.modified = True
        self.status = ""
        if self.path:
            self.debounce("autosave", AUTOSAVE_DELAY_MS, self.autosave)
        else:
            self.debounce("draft", 600, self.write_draft)
        self.window.document_changed(self, edited=True)

    # ----- highlighting -----

    def _mark_dirty(self, first, last):
        if self._dirty_lines:
            first, last = min(first, self._dirty_lines[0]), max(last, self._dirty_lines[1])
        self._dirty_lines = (first, last)
        if not self._highlight_source:
            # before the next redraw, so markers never flash unstyled
            self._highlight_source = GLib.idle_add(self.highlight, priority=GLib.PRIORITY_HIGH_IDLE)

    def _on_insert_text(self, _buffer, location, text, _length):
        last = location.get_line()
        self._mark_dirty(last - text.count("\n"), last)

    def _on_delete_range(self, _buffer, start, _end):
        line = start.get_line()
        self._mark_dirty(line, line)

    def highlight(self, full=False):
        if self._highlight_source:
            if full:
                GLib.source_remove(self._highlight_source)
            self._highlight_source = 0
        lines = None if full else self._dirty_lines
        self._dirty_lines = None
        if lines:
            start = self.buffer.get_iter_at_line(max(0, lines[0]))[1]
            end = self.buffer.get_iter_at_line(lines[1])[1]
            end.forward_line()
        else:
            start, end = self.buffer.get_bounds()
        for name in SYNTAX_TAGS:
            self.buffer.remove_tag_by_name(name, start, end)
        if not is_markdown(self.path):
            return False

        # fenced code decides how the lines below it read, so check from the top
        text = self.text()
        offset = start.get_offset()
        in_fence = len(re.findall(r"^\s*(```|~~~)", text[:offset], re.MULTILINE)) % 2 == 1
        if in_fence and lines:
            # an edit inside or around a fence can change everything after it
            end = self.buffer.get_end_iter()
        for line in self.buffer.get_text(start, end, True).split("\n"):
            if re.match(r"^\s*(```|~~~)", line):
                self._tag("code", offset, len(line))
                in_fence = not in_fence
            elif in_fence:
                self._tag("code", offset, len(line))
            elif line.strip():
                self._highlight_line(line, offset)
            offset += len(line) + 1
        return False

    def _tag(self, name, start, length):
        if length > 0:
            self.buffer.apply_tag_by_name(name, self.buffer.get_iter_at_offset(start),
                                          self.buffer.get_iter_at_offset(start + length))

    def _highlight_line(self, line, base):
        first = len(line) - len(line.lstrip())
        char = line[first]
        if first == 0 and char == "#":
            heading = re.match(r"^(#{1,6})(\s+)(.*)$", line)
            if heading:
                self._tag("marker", base, heading.end(2))
                self._tag("heading", base + heading.start(3), len(heading.group(3)))
                return
        if char == ">":
            quote = re.match(r"^(\s*>+\s?)(.*)$", line)
            if quote:
                self._tag("marker", base, len(quote.group(1)))
                self._tag("quote", base + quote.start(2), len(quote.group(2)))
        if char in "-+*" or char.isdigit():
            item = re.match(r"^(\s*(?:[-+*]|\d+[.)])\s+(?:\[[ xX]\]\s+)?)(.*)$", line)
            if item:
                self._tag("marker", base, len(item.group(1)))
        if char in "-*_" and re.match(r"^\s{0,3}([-*_])(?:\s*\1){2,}\s*$", line):
            self._tag("marker", base, len(line))
        if "`" in line:
            for code in re.finditer(r"`([^`]+)`", line):
                self._tag("code", base + code.start(), len(code.group()))
        for kind, (start, length), markers in inline_markup(line):
            self._tag(kind, base + start, length)
            for marker_start, marker_length in markers:
                self._tag("marker", base + marker_start, marker_length)

    # ----- files -----

    def load(self, path):
        """Read path into the buffer. Returns False (and sets the status) if it can't be read."""
        try:
            with open(path, "rb") as f:
                contents = f.read()
        except OSError as e:
            self.set_status(f"Could not open {os.path.basename(path)}: {e.strerror.lower()}")
            return False
        self.path = os.path.abspath(path)
        self.known_contents = contents
        self.set_text(contents.decode("utf-8", errors="replace"))
        self.watch()
        self.clear_draft()
        return True

    def save_to(self, path, quiet=False):
        """Write the buffer to path. Returns True on success."""
        contents = self.text().encode()
        self.unwatch()  # our own write isn't an outside change
        try:
            atomic_write(path, contents)
        except OSError as e:
            self.watch()
            self.set_status(f"Could not save {os.path.basename(path)}: {e.strerror.lower()}")
            return False
        self.cancel("autosave")
        self.cancel("draft")
        self.path = os.path.abspath(path)
        self.known_contents = contents
        self.watch()
        self.clear_draft()
        self.modified = False
        self.status = "Saved" if quiet else f"Saved {self.name()}"
        self.highlight(full=True)  # the file type may have changed
        self.window.document_changed(self)
        return True

    def autosave(self):
        if self.path and self.modified and not self.external_dialog:
            if os.path.isdir(os.path.dirname(self.path)):
                self.save_to(self.path, quiet=True)

    def draft_path(self):
        return os.path.join(DRAFTS_DIR, self.draft_id + ".json")

    def write_draft(self):
        """Untitled (or unsavable) text survives closing the window and crashes."""
        if not self.modified:
            return
        try:
            os.makedirs(DRAFTS_DIR, exist_ok=True)
            atomic_write(self.draft_path(), json.dumps({"file": self.path or "", "text": self.text()}).encode())
        except OSError:
            pass

    def clear_draft(self):
        try:
            os.remove(self.draft_path())
        except FileNotFoundError:
            pass

    def restore_draft(self):
        data = read_json(self.draft_path(), {})
        if not isinstance(data.get("text"), str):
            return False
        if self.path:
            try:
                with open(self.path, "rb") as f:
                    self.known_contents = f.read()
            except OSError:
                self.known_contents = None
            self.watch()
        self.set_text(data["text"], modified=True)
        return True

    # ----- outside changes -----

    def unwatch(self):
        self.cancel("external")
        if self.monitor:
            self.monitor.cancel()
            self.monitor = None

    def watch(self):
        self.unwatch()
        if self.path and os.path.exists(self.path):
            self.monitor = Gio.File.new_for_path(self.path).monitor_file(Gio.FileMonitorFlags.WATCH_MOVES, None)
            self.monitor.connect("changed", lambda *_: self.debounce("external", 250, self.check_external_change))

    def check_external_change(self):
        if not self.path or self.external_dialog:
            return
        deleted = not os.path.exists(self.path)
        contents = None
        if not deleted:
            try:
                with open(self.path, "rb") as f:
                    contents = f.read()
            except OSError:
                return
            if contents == self.known_contents:
                return  # an atomic save replaced the file with what we already have
        if not deleted and not self.modified:
            # nothing of ours to lose: follow the file, like other editors do
            cursor = self.cursor
            self.known_contents = contents
            self.set_text(contents.decode("utf-8", errors="replace"))
            self.buffer.place_cursor(self.buffer.get_iter_at_offset(min(cursor, self.buffer.get_char_count())))
            self.set_status("Reloaded from disk")
            return
        self.window.show_document(self)
        if deleted:
            body = f"{self.name()} was removed outside Walwrite. Keep your text as an unsaved document?"
        else:
            body = f"{self.name()} changed outside Walwrite. Reloading will discard your changes."

        def respond(response):
            self.external_dialog = None
            if response == "reload" and not deleted:
                self.load(self.path)
                self.set_status("Reloaded from disk")
            elif deleted:
                # an untitled document now, so autosave doesn't quietly bring the file back
                self.unwatch()
                self.path = None
                self.known_contents = None
                self.modified = True
                self.write_draft()
                self.set_status("Kept as an unsaved document")
            else:
                try:
                    with open(self.path, "rb") as f:
                        self.known_contents = f.read()
                except OSError:
                    self.known_contents = None
                self.cancel("autosave")  # don't overwrite their version until the next edit
                self.modified = True
                self.watch()
                self.write_draft()
                self.set_status("Kept your version")

        self.external_dialog = choice_dialog(
            self.window, "File removed" if deleted else "File changed", body,
            [("Keep Mine", "keep", deleted, True), ("Reload", "reload", not deleted, not deleted)],
            respond, focus="keep" if deleted else "reload")


# ---------- widgets ----------

class Editor(Gtk.TextView):
    """The writing column: about 72 characters wide and centered, with equal room on both sides."""

    def __init__(self):
        super().__init__(wrap_mode=Gtk.WrapMode.WORD_CHAR, bottom_margin=240,
                         pixels_below_lines=LINE_GAP, pixels_inside_wrap=LINE_GAP)
        self.add_css_class("editor")
        self._last_width = 0

    def do_size_allocate(self, width, height, baseline):
        if width != self._last_width:
            self._last_width = width
            self.update_margins(width, height)
        Gtk.TextView.do_size_allocate(self, width, height, baseline)

    def update_margins(self, width=None, height=None):
        width = width or self.get_width()
        height = height or self.get_height()
        if not width:
            return
        layout = self.create_pango_layout("0" * 50)
        char = layout.get_pixel_size()[0] / 50
        column = round(char * 72)
        gutter = max(16, min(round(char * 3), width // 12))  # small windows keep a thin, even edge
        side = max(gutter, (width - column) // 2)
        self.set_left_margin(side)
        self.set_right_margin(side)
        self.set_top_margin(max(28, round(height * 0.04)) if height else 36)


class Sidebar(Gtk.Box):
    """Open documents on top, and a folder's text files below."""

    def __init__(self, window):
        # hexpand=False explicitly, or the expanding labels inside make it take half the window
        super().__init__(orientation=Gtk.Orientation.VERTICAL, width_request=240, hexpand=False)
        self.add_css_class("sidebar")
        self.window = window
        self.folder = None
        self.rows = {}

        header = Gtk.Box()
        header.append(Gtk.Label(label="OPEN", xalign=0, hexpand=True, css_classes=["section"]))
        new = Gtk.Button(label="", tooltip_text="New document (Ctrl+N)", valign=Gtk.Align.END)
        new.connect("clicked", lambda _b: window.activate_action("win.new-document"))
        header.append(new)
        self.append(header)
        self.documents = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        self.documents.connect("row-activated", lambda _l, row: window.show_document(row.document))
        self.append(self.documents)

        folder_header = Gtk.Box()
        self.folder_label = Gtk.Label(label="FILES", xalign=0, hexpand=True, css_classes=["section"],
                                      ellipsize=Pango.EllipsizeMode.START)
        folder_header.append(self.folder_label)
        for glyph, tip, action in (("", "Parent folder", self.go_up),
                                   ("", "Open folder (Ctrl+Shift+O)", lambda: window.activate_action("win.open-folder"))):
            button = Gtk.Button(label=glyph, tooltip_text=tip, valign=Gtk.Align.END)
            button.connect("clicked", lambda _b, a=action: a())
            folder_header.append(button)
        self.append(folder_header)

        self.tree = None
        factory = Gtk.SignalListItemFactory()
        factory.connect("setup", self._setup_item)
        factory.connect("bind", self._bind_item)
        self.file_view = Gtk.ListView(factory=factory, single_click_activate=True)
        self.file_view.connect("activate", self._activate_file)
        scroller = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER, child=self.file_view)
        self.append(scroller)

    # ----- open documents -----

    def refresh_documents(self, documents, current):
        existing = {id(doc) for doc in documents}
        for key in [k for k in self.rows if k not in existing]:
            self.documents.remove(self.rows.pop(key))
        for index, doc in enumerate(documents):
            row = self.rows.get(id(doc))
            if row is None:
                row = Gtk.ListBoxRow()
                row.document = doc
                box = Gtk.Box(spacing=6)
                row.dot = Gtk.Label(label="●", css_classes=["dim"])
                row.title = Gtk.Label(xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.END)
                close = Gtk.Button(label="", tooltip_text="Close (Ctrl+W)")
                close.connect("clicked", lambda _b, d=doc: self.window.close_document(d))
                box.append(row.title)
                box.append(row.dot)
                box.append(close)
                row.set_child(box)
                self.rows[id(doc)] = row
                self.documents.insert(row, index)
            elif row.get_index() != index:
                self.documents.remove(row)
                self.documents.insert(row, index)
            row.title.set_label(doc.name())
            row.set_tooltip_text(short_path(doc.path) if doc.path else "Not saved yet")
            row.dot.set_opacity(1 if doc.modified and not doc.path else 0.6 if doc.modified else 0)
        if current is not None and id(current) in self.rows:
            self.documents.select_row(self.rows[id(current)])

    # ----- folder tree -----

    def set_folder(self, folder):
        if not folder or not os.path.isdir(folder) or folder == self.folder:
            return
        self.folder = folder
        self.folder_label.set_label(os.path.basename(folder.rstrip("/")) or "/")
        self.folder_label.set_tooltip_text(short_path(folder))
        root = self._directory_model(Gio.File.new_for_path(folder))
        self.tree = Gtk.TreeListModel.new(root, False, False, self._children)
        self.file_view.set_model(Gtk.NoSelection(model=self.tree))

    def go_up(self):
        if self.folder:
            self.set_folder(os.path.dirname(self.folder.rstrip("/")) or "/")
            self.window.save_session_soon()

    @staticmethod
    def _directory_model(directory):
        listing = Gtk.DirectoryList(file=directory, attributes="standard::name,standard::type,standard::is-hidden")

        def visible(info):
            name = info.get_name()
            if info.get_is_hidden() or name.startswith(".") or name in ("node_modules", "__pycache__"):
                return False
            return info.get_file_type() == Gio.FileType.DIRECTORY or is_text_file(name)

        filtered = Gtk.FilterListModel(model=listing, filter=Gtk.CustomFilter.new(visible))

        def order(a, b, _data):
            a_dir = a.get_file_type() == Gio.FileType.DIRECTORY
            b_dir = b.get_file_type() == Gio.FileType.DIRECTORY
            if a_dir != b_dir:
                return -1 if a_dir else 1
            return (a.get_name().lower() > b.get_name().lower()) - (a.get_name().lower() < b.get_name().lower())

        return Gtk.SortListModel(model=filtered, sorter=Gtk.CustomSorter.new(order, None))

    def _children(self, info):
        if info.get_file_type() != Gio.FileType.DIRECTORY:
            return None
        return self._directory_model(info.get_attribute_object("standard::file"))

    @staticmethod
    def _setup_item(_factory, item):
        expander = Gtk.TreeExpander()
        box = Gtk.Box(spacing=6)
        icon = Gtk.Label(css_classes=["dim"])
        icon.set_attributes(Pango.AttrList.from_string(f'0 -1 font-desc "{ICON_FONT}"'))
        name = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END, hexpand=True)
        box.append(icon)
        box.append(name)
        expander.set_child(box)
        item.set_child(expander)

    def _bind_item(self, _factory, item):
        row = item.get_item()
        info = row.get_item()
        expander = item.get_child()
        expander.set_list_row(row)
        icon, name = expander.get_child().get_first_child(), expander.get_child().get_last_child()
        is_dir = info.get_file_type() == Gio.FileType.DIRECTORY
        icon.set_label(("" if not row.get_expanded() else "") if is_dir else "")
        name.set_label(info.get_name())

    def _activate_file(self, _view, position):
        row = self.tree.get_item(position)
        info = row.get_item()
        if info.get_file_type() == Gio.FileType.DIRECTORY:
            row.set_expanded(not row.get_expanded())
            self.file_view.get_model().items_changed(position, 1, 1)  # redraw the folder icon
        else:
            path = info.get_attribute_object("standard::file").get_path()
            if path:
                self.window.open_path(path)


class Preview(Gtk.Box):
    """Rendered Markdown: WebKitGTK when it's installed, otherwise a plain GTK rendering."""

    def __init__(self, window):
        super().__init__(hexpand=True, vexpand=True)
        self.window = window
        self.pending = None
        if WebKit:
            settings = WebKit.Settings(enable_javascript=True, enable_developer_extras=False,
                                       allow_file_access_from_file_urls=True)
            self.web = WebKit.WebView(settings=settings, hexpand=True, vexpand=True)
            self.web.set_background_color(Gdk.RGBA())
            self.web.connect("decide-policy", self._decide_policy)
            self.append(self.web)
            self.text = None
        else:
            self.web = None
            self.text = Gtk.TextView(editable=False, cursor_visible=False, wrap_mode=Gtk.WrapMode.WORD_CHAR,
                                     pixels_below_lines=LINE_GAP, pixels_inside_wrap=4,
                                     left_margin=48, right_margin=48, top_margin=36, bottom_margin=200)
            self.text.add_css_class("preview")
            self.append(Gtk.ScrolledWindow(child=self.text, hexpand=True, vexpand=True,
                                           hscrollbar_policy=Gtk.PolicyType.NEVER))

    def render(self, document, palette, font_size):
        text = document.text()
        if self.web:
            body = markdown_to_html(text) if is_markdown(document.path) else f"<pre>{html.escape(text)}</pre>"
            page = (f"<!doctype html><html><head><meta charset='utf-8'><style>{preview_css(palette, font_size)}"
                    f"</style></head><body>{body}</body></html>")
            base = Gio.File.new_for_path(os.path.dirname(document.path)).get_uri() + "/" if document.path else None
            # keep the scroll position across re-renders
            self.web.evaluate_javascript("window.scrollY", -1, None, None, None, self._reload, (page, base))
        else:
            buffer = self.text.get_buffer()
            buffer.set_text("")
            markup = markdown_to_pango(text) if is_markdown(document.path) else escape_markup(text)
            buffer.insert_markup(buffer.get_start_iter(), markup, -1)

    def _reload(self, web, result, page_and_base):
        page, base = page_and_base
        try:
            scroll = web.evaluate_javascript_finish(result).to_double()
        except (GLib.Error, AttributeError):
            scroll = 0
        web.load_html(page.replace("</body>", f"<script>window.scrollTo(0,{scroll})</script></body>"), base)

    def _decide_policy(self, _web, decision, decision_type):
        if decision_type != WebKit.PolicyDecisionType.NAVIGATION_ACTION:
            return False
        action = decision.get_navigation_action()
        uri = action.get_request().get_uri()
        if action.get_navigation_type() == WebKit.NavigationType.LINK_CLICKED:
            decision.ignore()
            try:
                if uri.startswith("file://") and is_text_file(Gio.File.new_for_uri(uri).get_path() or ""):
                    self.window.open_path(Gio.File.new_for_uri(uri).get_path())
                else:
                    Gio.AppInfo.launch_default_for_uri(uri, None)
            except GLib.Error:
                pass
            return True
        return False


