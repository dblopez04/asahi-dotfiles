# ---------- text helpers ----------

def count_words(text):
    return len(re.findall(r"[^\W_]+(?:['-][^\W_]+)*", text))


def normalized_link_url(clipboard_text):
    """The clipboard as a link destination, or "" when it isn't a web or mailto URL."""
    candidate = re.split(r"[\r\n]", clipboard_text.strip(), maxsplit=1)[0].strip()
    if not candidate:
        return ""
    if candidate.lower().startswith("www."):
        candidate = "https://" + candidate
    if not re.match(r"^[A-Za-z][A-Za-z0-9+.-]*:", candidate):
        return ""
    try:
        parts = urlsplit(candidate)
    except ValueError:
        return ""
    scheme = parts.scheme.lower()
    if scheme in ("http", "https", "ftp"):
        return candidate if parts.netloc else ""
    return candidate if scheme == "mailto" else ""


def suggested_file_name(text):
    name = re.sub(r"^#+\s*", "", text.split("\n", 1)[0].strip())
    name = re.sub(r"[/\x00-\x1f\x7f]", "-", name)[:120].strip()
    if name in ("", ".", ".."):
        name = "Untitled"
    if not name.lower().endswith(TEXT_FILES):
        name += ".md"
    return name


def escape_link_text(text):
    return text.replace("\\", "\\\\").replace("[", "\\[").replace("]", "\\]")


def escape_link_destination(url):
    return url.replace("\\", "\\\\").replace("(", "\\(").replace(")", "\\)")


def inline_markup(text):
    """Bold, italic, and link spans in one line: (kind, (start, length), [marker spans])."""
    markup = []
    if "*" not in text and "_" not in text and "[" not in text:
        return markup
    for m in re.finditer(r"(\*\*|__)(.+?)(\1)", text):
        markup.append(("bold", (m.start(2), len(m.group(2))),
                       [(m.start(1), len(m.group(1))), (m.start(3), len(m.group(3)))]))
    for m in re.finditer(r"(?<![*\w])\*([^*\n]+)\*(?!\*)|(?<![_\w])_([^_\n]+)_(?![_\w])", text):
        group = 1 if m.group(1) is not None else 2
        markup.append(("italic", (m.start(group), len(m.group(group))),
                       [(m.start(), 1), (m.end() - 1, 1)]))
    for m in re.finditer(r"!?\[([^\]]+)\]\(((?:\\.|[^)])+)\)", text):
        content_end = m.end(1)
        opener = 2 if m.group().startswith("!") else 1
        markup.append(("link", (m.start(1), len(m.group(1))),
                       [(m.start(), opener), (content_end, m.end() - content_end)]))
    return markup


def escape_markup(text):
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def is_text_file(path):
    return path.lower().endswith(TEXT_FILES)


def is_markdown(path):
    return path is None or not path.lower().endswith((".txt", ".text"))


def atomic_write(path, data):
    """Write through a temp file and rename, keeping the target's permissions and symlinks."""
    path = os.path.realpath(path)
    try:
        mode = stat.S_IMODE(os.stat(path).st_mode)
    except FileNotFoundError:
        umask = os.umask(0)
        os.umask(umask)
        mode = 0o666 & ~umask
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix="." + os.path.basename(path) + ".")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def read_json(path, default):
    try:
        with open(path) as f:
            value = json.load(f)
        return value if isinstance(value, type(default)) else default
    except (OSError, ValueError):
        return default


def write_json(path, value):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        atomic_write(path, json.dumps(value, indent=1).encode())
    except OSError:
        pass


def read_settings():
    return read_json(SETTINGS_FILE, {})


def update_settings(**values):
    settings = read_settings()
    settings.update(values)
    write_json(SETTINGS_FILE, settings)


def short_path(path):
    home = os.path.expanduser("~")
    return "~" + path[len(home):] if path == home or path.startswith(home + "/") else path


# ---------- markdown rendering ----------

def render_inline(text):
    """Inline Markdown to HTML: code, images, links, bold, italic, strikethrough, autolinks."""
    stash = []

    def keep(fragment):
        stash.append(fragment)
        return f"\x00{len(stash) - 1}\x00"

    text = re.sub(r"`([^`]+)`", lambda m: keep(f"<code>{html.escape(m.group(1))}</code>"), text)
    text = re.sub(r"!\[([^\]]*)\]\(([^)\s]+)(?:\s+\"([^\"]*)\")?\)",
                  lambda m: keep(f'<img src="{html.escape(m.group(2))}" alt="{html.escape(m.group(1))}">'), text)
    text = re.sub(r"<(https?://[^>\s]+)>", lambda m: keep(f'<a href="{html.escape(m.group(1))}">'
                                                         f'{html.escape(m.group(1))}</a>'), text)
    links = []
    text = re.sub(r"\[([^\]]+)\]\(((?:\\.|[^)])+)\)",
                  lambda m: links.append((m.group(1), m.group(2).replace("\\)", ")").replace("\\(", "(")))
                  or f"\x01{len(links) - 1}\x01", text)
    text = html.escape(text, quote=False)
    text = re.sub(r"(\*\*|__)(.+?)\1", r"<strong>\2</strong>", text)
    text = re.sub(r"(?<![*\w])\*([^*\n]+)\*(?!\*)|(?<![_\w])_([^_\n]+)_(?![_\w])",
                  lambda m: f"<em>{m.group(1) or m.group(2)}</em>", text)
    text = re.sub(r"~~(.+?)~~", r"<del>\1</del>", text)
    text = re.sub(r"\x01(\d+)\x01", lambda m: '<a href="{}">{}</a>'.format(
        html.escape(links[int(m.group(1))][1]), render_inline(links[int(m.group(1))][0])), text)
    return re.sub(r"\x00(\d+)\x00", lambda m: stash[int(m.group(1))], text)


def markdown_blocks(text):
    """A small CommonMark-ish block parser: [(kind, data)] for headings, paragraphs, lists,
    quotes, fenced code, rules and tables. Used when python-markdown isn't installed."""
    lines = text.replace("\r\n", "\n").split("\n")
    blocks, i = [], 0
    while i < len(lines):
        line = lines[i]
        if not line.strip():
            i += 1
            continue
        fence = re.match(r"^\s*(```|~~~)\s*(\S*)", line)
        if fence:
            body, i = [], i + 1
            while i < len(lines) and not lines[i].strip().startswith(fence.group(1)):
                body.append(lines[i])
                i += 1
            blocks.append(("code", (fence.group(2), "\n".join(body))))
            i += 1
            continue
        heading = re.match(r"^(#{1,6})\s+(.*?)\s*#*\s*$", line)
        if heading:
            blocks.append(("heading", (len(heading.group(1)), heading.group(2))))
            i += 1
            continue
        if re.match(r"^\s{0,3}([-*_])(?:\s*\1){2,}\s*$", line):
            blocks.append(("rule", None))
            i += 1
            continue
        if line.lstrip().startswith(">"):
            body = []
            while i < len(lines) and lines[i].lstrip().startswith(">"):
                body.append(re.sub(r"^\s*>\s?", "", lines[i]))
                i += 1
            blocks.append(("quote", markdown_blocks("\n".join(body))))
            continue
        item = re.match(r"^(\s*)([-+*]|\d+[.)])\s+(.*)$", line)
        if item:
            ordered = item.group(2)[0].isdigit()
            items = []
            while i < len(lines):
                m = re.match(r"^(\s*)([-+*]|\d+[.)])\s+(.*)$", lines[i])
                if m and bool(m.group(2)[0].isdigit()) == ordered and len(m.group(1)) <= len(item.group(1)) + 1:
                    items.append([m.group(3)])
                elif m or (lines[i].startswith("  ") and items):
                    items[-1].append(lines[i].strip() if not m else lines[i][len(item.group(1)) + 2:])
                else:
                    break
                i += 1
            start = int(item.group(2)[:-1]) if ordered else 1
            blocks.append(("list", (ordered, start, items)))
            continue
        if "|" in line and i + 1 < len(lines) and re.match(r"^\s*\|?\s*:?-+:?\s*(\|\s*:?-+:?\s*)*\|?\s*$", lines[i + 1]):
            split = lambda row: [cell.strip() for cell in row.strip().strip("|").split("|")]
            header, rows, i = split(line), [], i + 2
            while i < len(lines) and "|" in lines[i] and lines[i].strip():
                rows.append(split(lines[i]))
                i += 1
            blocks.append(("table", (header, rows)))
            continue
        body = []
        while i < len(lines) and lines[i].strip() and not re.match(r"^(#{1,6}\s|\s*(```|~~~)|\s*>)", lines[i]):
            body.append(lines[i])
            i += 1
        blocks.append(("paragraph", "\n".join(body)))
    return blocks


def blocks_to_html(blocks):
    parts = []
    for kind, data in blocks:
        if kind == "heading":
            parts.append(f"<h{data[0]}>{render_inline(data[1])}</h{data[0]}>")
        elif kind == "paragraph":
            parts.append("<p>" + "<br>".join(render_inline(l) for l in data.split("\n")) + "</p>")
        elif kind == "code":
            language = f' class="language-{html.escape(data[0])}"' if data[0] else ""
            parts.append(f"<pre><code{language}>{html.escape(data[1])}</code></pre>")
        elif kind == "rule":
            parts.append("<hr>")
        elif kind == "quote":
            parts.append(f"<blockquote>{blocks_to_html(data)}</blockquote>")
        elif kind == "list":
            ordered, start, items = data
            tag = "ol" if ordered else "ul"
            rendered = []
            for item in items:
                task = re.match(r"^\[([ xX])\]\s+(.*)", item[0])
                if task:
                    box = '<input type="checkbox" disabled{}> '.format(" checked" if task.group(1) != " " else "")
                    item = [task.group(2)] + item[1:]
                else:
                    box = ""
                body = blocks_to_html(markdown_blocks("\n".join(item)))
                body = re.sub(r"^<p>(.*?)</p>", r"\1", body, count=1, flags=re.S)
                rendered.append(f"<li>{box}{body}</li>")
            attribute = f' start="{start}"' if ordered and start != 1 else ""
            parts.append(f"<{tag}{attribute}>{''.join(rendered)}</{tag}>")
        elif kind == "table":
            header, rows = data
            head = "".join(f"<th>{render_inline(c)}</th>" for c in header)
            body = "".join("<tr>" + "".join(f"<td>{render_inline(c)}</td>" for c in row) + "</tr>" for row in rows)
            parts.append(f"<table><thead><tr>{head}</tr></thead><tbody>{body}</tbody></table>")
    return "\n".join(parts)


def markdown_to_html(text):
    if python_markdown:
        try:
            return python_markdown.markdown(text, extensions=["extra", "sane_lists", "nl2br"])
        except Exception:
            pass
    return blocks_to_html(markdown_blocks(text))


def markdown_to_pango(text):
    """A light rendering for printing and the preview without WebKit."""
    out = []
    for kind, data in markdown_blocks(text):
        if kind == "heading":
            size = {1: "xx-large", 2: "x-large", 3: "large"}.get(data[0], "medium")
            out.append(f'<span size="{size}" weight="bold">{pango_inline(data[1])}</span>')
        elif kind == "paragraph":
            out.append("\n".join(pango_inline(l) for l in data.split("\n")))
        elif kind == "code":
            out.append(f"<tt>{escape_markup(data[1])}</tt>")
        elif kind == "rule":
            out.append("<span alpha=\"50%\">" + "─" * 40 + "</span>")
        elif kind == "quote":
            out.append("<i>" + re.sub(r"<[^>]+>", "", blocks_to_html(data)) + "</i>")
        elif kind == "list":
            ordered, start, items = data
            out.append("\n".join(f"  {f'{start + n}.' if ordered else '•'} {pango_inline(' '.join(item))}"
                                 for n, item in enumerate(items)))
        elif kind == "table":
            header, rows = data
            out.append("\n".join("<tt>" + "  │  ".join(escape_markup(c) for c in row) + "</tt>"
                                 for row in [header] + rows))
    markup = "\n\n".join(out)
    try:
        Pango.parse_markup(markup, -1, "\0")
    except GLib.Error:
        markup = escape_markup(text)
    return markup


def pango_inline(line):
    text = escape_markup(line)
    text = re.sub(r"`([^`]+)`", r"<tt>\1</tt>", text)
    text = re.sub(r"(\*\*|__)(.+?)\1", r"<b>\2</b>", text)
    text = re.sub(r"(?<![*\w])\*([^*\n]+)\*(?!\*)", r"<i>\1</i>", text)
    text = re.sub(r"!?\[([^\]]+)\]\([^)]*\)", r"<u>\1</u>", text)
    return text


# ---------- theme ----------

def load_palette():
    palette = {"background": "#101010", "foreground": "#eeeeee", "accent": "#5584aa"}
    try:
        with open(os.path.join(WAL_DIR, "colors.json")) as f:
            colors = json.load(f)
        palette["background"] = colors["special"]["background"]
        palette["foreground"] = colors["special"]["foreground"]
        palette["accent"] = colors["colors"]["color1"]  # fuzzel's selection and border color
    except (OSError, ValueError, KeyError):
        pass
    return palette


def mix(base, tint, amount):
    a = [int(base[i:i + 2], 16) for i in (1, 3, 5)]
    b = [int(tint[i:i + 2], 16) for i in (1, 3, 5)]
    return "#%02x%02x%02x" % tuple(round(x + (y - x) * amount) for x, y in zip(a, b))


def theme_css(p, font_size):
    bg, fg, accent = p["background"], p["foreground"], p["accent"]
    muted = mix(bg, fg, 0.5)
    raised = mix(bg, fg, 0.04)
