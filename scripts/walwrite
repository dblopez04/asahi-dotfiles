def build_menu_model():
    model = Gio.Menu()
    for title, sections in MENUS:
        menu = Gio.Menu()
        for section in sections:
            part = Gio.Menu()
            for label, action in section:
                item = Gio.MenuItem.new(label, None)
                name, _, target = action.partition("::")
                if target:
                    item.set_action_and_target_value(name, GLib.Variant("s", target))
                else:
                    item.set_detailed_action(name)
                part.append_item(item)
            menu.append_section(None, part)
        model.append_submenu(title, menu)
    return model


class WriterWindow(Gtk.ApplicationWindow):
    def __init__(self, app, state=None):
        super().__init__(application=app, title="Walwrite")
        self.set_decorated(False)
        self.add_css_class("walwrite")
        self.app = app
        state = state or {}
        settings = read_settings()
        self.set_default_size(state.get("width") or settings.get("width", 1100),
                              state.get("height") or settings.get("height", 760))
        if state.get("maximized"):
            self.maximize()

        self.documents = []
        self.current = None
        self.font_size = float(state.get("font_size") or settings.get("font_size", 14))
        self.search_open = False
        self.search_matches = []
        self.search_index = -1
        self.mode = "edit"  # edit, preview, or split
        self.closing = False
        self.palette = load_palette()
        self._alt_alone = False
        self._timeouts = {}

        self.tag_table = Gtk.TextTagTable()
        self._create_tags()
        self.css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), self.css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_USER + 100)
        self._build()
        self._add_actions()
        self._apply_theme()

        self.theme_monitor = Gio.File.new_for_path(WAL_DIR).monitor_directory(Gio.FileMonitorFlags.NONE, None)
        self.theme_monitor.connect("changed", self._on_wal_changed)
        self.connect("close-request", self._on_close_request)
        self.connect("notify::is-active", lambda *_: self._on_focus_change())

        self.sidebar_revealer.set_reveal_child(state.get("sidebar", settings.get("sidebar", False)))
        # without a remembered folder, the first file opened decides it (see show_document)
        self.sidebar.set_folder(state.get("folder") or settings.get("folder"))

    # ----- layout -----

    def _build(self):
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.set_child(root)

        self.menubar = Gtk.PopoverMenuBar.new_from_model(build_menu_model())
        self.menubar_revealer = Gtk.Revealer(child=self.menubar, reveal_child=False,
                                             transition_type=Gtk.RevealerTransitionType.SLIDE_DOWN,
                                             transition_duration=120)
        root.append(self.menubar_revealer)

        body = Gtk.Box(vexpand=True)
        root.append(body)
        self.sidebar = Sidebar(self)
        self.sidebar_revealer = Gtk.Revealer(child=self.sidebar, transition_duration=150,
                                             transition_type=Gtk.RevealerTransitionType.SLIDE_RIGHT)
        self.sidebar_revealer.connect("notify::reveal-child", lambda *_: self._sync_toggles())
        body.append(self.sidebar_revealer)

        overlay = Gtk.Overlay(hexpand=True)
        body.append(overlay)
        self.panes = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL, wide_handle=False,
                               shrink_start_child=False, shrink_end_child=False)
        overlay.set_child(self.panes)

        self.scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, hexpand=True)
        self.view = Editor()
        self.scroller.set_child(self.view)
        self.panes.set_start_child(self.scroller)
        self.preview = Preview(self)
        self.preview.set_visible(False)
        self.panes.set_end_child(self.preview)

        self.placeholder = Gtk.Label(label="# Start writing", can_target=False,
                                     halign=Gtk.Align.START, valign=Gtk.Align.START)
        self.placeholder.add_css_class("placeholder")
        overlay.add_overlay(self.placeholder)
        self.view.connect("notify::left-margin", lambda *_: self._place_placeholder())
        self.view.connect("notify::top-margin", lambda *_: self._place_placeholder())
        self.view.connect("notify::has-focus", lambda *_: self._update_placeholder())

        self.search_pane = self._build_search()
        overlay.add_overlay(self.search_pane)

        footer = Gtk.Box(spacing=4, css_classes=["footer"])
        self.sidebar_button = self._footer_button("", "Sidebar (Ctrl+\\)", "win.sidebar")
        footer.append(self.sidebar_button)
        footer.append(self._footer_button("", "Save (Ctrl+S)", "win.save"))
        footer.append(self._footer_button("", "Open (Ctrl+O)", "win.open"))
        self.status_label = Gtk.Label(xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.END, margin_start=8)
        footer.append(self.status_label)
        self.words_label = Gtk.Label(label="0 words", margin_end=8)
        footer.append(self.words_label)
        self.preview_button = self._footer_button("", "Rendered Markdown (Ctrl+E)", "win.preview")
        footer.append(self.preview_button)
        root.append(footer)

        keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self._on_key_pressed)
        keys.connect("key-released", self._on_key_released)
        self.add_controller(keys)
        editor_keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        editor_keys.connect("key-pressed", self._on_editor_key)
        self.view.add_controller(editor_keys)
        click = Gtk.GestureClick(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        click.connect("pressed", lambda *_: self._hide_menubar_unless_open())
        self.view.add_controller(click)

    def _footer_button(self, glyph, tooltip, action):
        button = Gtk.Button(label=glyph, tooltip_text=tooltip, focusable=False, action_name=action)
        return button

    def _build_search(self):
        pane = Gtk.Box(spacing=8, valign=Gtk.Align.START, visible=False,
                       margin_top=12, margin_start=12, margin_end=12)
        pane.add_css_class("search")
        fields = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True, valign=Gtk.Align.CENTER)
        self.find_entry = Gtk.Entry(placeholder_text="Find", hexpand=True)
        self.replace_entry = Gtk.Entry(placeholder_text="Replace with", hexpand=True, visible=False)
        self.find_entry.connect("changed", lambda _e: self.update_search())
        fields.append(self.find_entry)
        fields.append(self.replace_entry)
        for entry, handler in ((self.find_entry, self._on_find_key), (self.replace_entry, self._on_replace_key)):
            keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
            keys.connect("key-pressed", handler)
            entry.add_controller(keys)

        self.count_label = Gtk.Label(label="0/0")
        self.count_label.add_css_class("count")
        self.replace_button = Gtk.Button(label="Replace", visible=False, valign=Gtk.Align.CENTER)
        self.replace_button.add_css_class("square")
        self.replace_button.connect("clicked", lambda _b: self.replace_current())
        self.replace_all_button = Gtk.Button(label="All", visible=False, valign=Gtk.Align.CENTER)
        self.replace_all_button.add_css_class("square")
        self.replace_all_button.connect("clicked", lambda _b: self.replace_all())
        pane.append(fields)
        pane.append(self.count_label)
        pane.append(self.replace_button)
        pane.append(self.replace_all_button)
        pane.append(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL))
        for glyph, tooltip, action in (("", "Previous match", lambda: self.move_search(-1)),
                                       ("", "Next match", lambda: self.move_search(1)),
                                       ("", "Close", self.close_search)):
            button = Gtk.Button(label=glyph, tooltip_text=tooltip, valign=Gtk.Align.CENTER)
            button.add_css_class("icon")
            button.connect("clicked", lambda _b, a=action: a())
            pane.append(button)
        return pane

    def _add_actions(self):
        simple = {
            "new-document": lambda: self.new_document(), "open": self.open_dialog,
            "open-folder": self.open_folder_dialog, "save": lambda: self.save(), "save-as": lambda: self.save_as(),
            "rename": self.rename, "print": self.print_document, "close-document": lambda: self.close_document(),
            "close-window": self.close, "undo": lambda: self._buffer_do("undo"), "redo": lambda: self._buffer_do("redo"),
            "cut": lambda: self.view.emit("cut-clipboard"), "copy": lambda: self.view.emit("copy-clipboard"),
            "paste": self.paste, "select-all": lambda: self.view.emit("select-all", True),
            "find": lambda: self.open_search(False), "replace": lambda: self.open_search(True),
            "bold": lambda: self.wrap_selection("**", "**"), "italic": lambda: self.wrap_selection("*", "*"),
            "code": lambda: self.wrap_selection("`", "`"), "link": self.insert_link,
            "bullets": lambda: self.prefix_lines("- "), "numbers": lambda: self.prefix_lines("1. "),
            "tasks": lambda: self.prefix_lines("- [ ] "), "quote": lambda: self.prefix_lines("> "),
            "sidebar": self.toggle_sidebar, "preview": lambda: self.set_mode("edit" if self.mode == "preview" else "preview"),
            "split": lambda: self.set_mode("edit" if self.mode == "split" else "split"),
            "zoom-in": lambda: self.zoom(1), "zoom-out": lambda: self.zoom(-1), "zoom-reset": lambda: self.zoom(0),
            "next-document": lambda: self.cycle_document(1), "previous-document": lambda: self.cycle_document(-1),
            "fullscreen": lambda: self.unfullscreen() if self.is_fullscreen() else self.fullscreen(),
            "shortcuts": self.show_shortcuts, "about": self.show_about,
        }
        for name, callback in simple.items():
            action = Gio.SimpleAction.new(name, None)
            action.connect("activate", lambda _a, _p, c=callback: (self._hide_menubar(), c()))
            self.add_action(action)
        heading = Gio.SimpleAction.new("heading", GLib.VariantType.new("s"))
        heading.connect("activate", lambda _a, level: (self._hide_menubar(), self.set_heading(int(level.get_string()))))
        self.add_action(heading)

    def _create_tags(self):
        for name in SYNTAX_TAGS + ("search", "current-search"):
            self.tag_table.add(Gtk.TextTag(name=name))
        self.tag_table.lookup("heading").set_property("weight", Pango.Weight.BOLD)
        self.tag_table.lookup("bold").set_property("weight", Pango.Weight.BOLD)
        self.tag_table.lookup("italic").set_property("style", Pango.Style.ITALIC)
        self.tag_table.lookup("quote").set_property("style", Pango.Style.ITALIC)
        self.tag_table.lookup("link").set_property("underline", Pango.Underline.SINGLE)

    # ----- theme -----

    def _apply_theme(self):
        p = self.palette
        bg, fg, accent = p["background"], p["foreground"], p["accent"]
        self.css.load_from_string(theme_css(p, self.font_size))
        marker = mix(bg, fg, 0.38)
        self.tag_table.lookup("marker").set_property("foreground", marker)
        self.tag_table.lookup("quote").set_property("foreground", mix(bg, fg, 0.7))
        self.tag_table.lookup("code").set_property("background", mix(bg, fg, 0.08))
        self.tag_table.lookup("link").set_property("foreground", accent)
        self.tag_table.lookup("search").set_property("background", mix(bg, accent, 0.45))
        self.tag_table.lookup("current-search").set_property("background", accent)
        self.tag_table.lookup("current-search").set_property("foreground", bg)
        GLib.idle_add(lambda: self.view.update_margins() or False)
        if self.mode != "edit":
            self.refresh_preview()

    def _on_wal_changed(self, _monitor, file, _other, _event):
        if file.get_basename() == "colors.json":
            self.debounce("theme", 150, self._reload_theme)

    def _reload_theme(self):
        self.palette = load_palette()
        self._apply_theme()

    def zoom(self, direction):
        self.font_size = 14 if direction == 0 else max(8, min(32, self.font_size + direction))
        self._apply_theme()
        update_settings(font_size=self.font_size)
        self.save_session_soon()

    # ----- helpers -----

    def debounce(self, name, ms, callback):
        if self._timeouts.get(name):
            GLib.source_remove(self._timeouts[name])

        def fire():
            self._timeouts[name] = 0
            callback()
            return False

        self._timeouts[name] = GLib.timeout_add(ms, fire)

    @property
    def buffer(self):
        return self.current.buffer

    def text(self):
        return self.current.text()

    def _cursor(self):
        return self.buffer.get_iter_at_mark(self.buffer.get_insert()).get_offset()

    def _selection(self):
        bounds = self.buffer.get_selection_bounds()
        if bounds:
            return bounds[0].get_offset(), bounds[1].get_offset()
        cursor = self._cursor()
        return cursor, cursor

    def _iter(self, offset):
        return self.buffer.get_iter_at_offset(offset)

    def _buffer_do(self, what):
        if self.view.has_focus() or not self.search_open:
            getattr(self.buffer, what)()
            self.view.scroll_mark_onscreen(self.buffer.get_insert())

    # ----- menu bar and keys -----

    def _show_menubar(self):
        self.menubar_revealer.set_reveal_child(True)

    def _hide_menubar(self):
        self.menubar_revealer.set_reveal_child(False)

    def _hide_menubar_unless_open(self):
        self._hide_menubar()

    def _on_key_pressed(self, _controller, keyval, _keycode, state):
        if keyval in (Gdk.KEY_Alt_L, Gdk.KEY_Alt_R):
            self._alt_alone = True
            return False
        self._alt_alone = False
        if keyval == Gdk.KEY_Escape and self.menubar_revealer.get_reveal_child():
            self._hide_menubar()
            self.view.grab_focus()
            return True
        return False

    def _on_key_released(self, _controller, keyval, _keycode, state):
        if keyval in (Gdk.KEY_Alt_L, Gdk.KEY_Alt_R) and self._alt_alone:
            self._alt_alone = False
            if self.menubar_revealer.get_reveal_child():
                self._hide_menubar()
                self.view.grab_focus()
            else:
                self._show_menubar()
                # let the keyboard walk the menus right away, like pressing F10
                GLib.idle_add(lambda: self.menubar.get_first_child() and
                              self.menubar.get_first_child().grab_focus() and False)

    def _on_editor_key(self, _controller, keyval, _keycode, state):
        mods = state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.ALT_MASK
                        | Gdk.ModifierType.SUPER_MASK | Gdk.ModifierType.META_MASK)
        shift = bool(state & Gdk.ModifierType.SHIFT_MASK)
        if mods:
            if mods == Gdk.ModifierType.CONTROL_MASK and Gdk.keyval_to_lower(keyval) == Gdk.KEY_v and not shift:
                self.paste()
                return True
            return False
        if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) and not shift:
            return self.continue_list()
        if keyval == Gdk.KEY_Tab and not shift:
            return self.indent_list_item(1)
        if keyval == Gdk.KEY_ISO_Left_Tab or (keyval == Gdk.KEY_Tab and shift):
            return self.indent_list_item(-1)
        return False


    # ----- editing -----

    def replace_range(self, start, end, replacement, select=None):
        """Replace [start, end) as one undo step; select=(from, to) offsets inside the replacement."""
        replacement = replacement.replace("\r\n", "\n").replace("\r", "\n")
        self.buffer.begin_user_action()
        if start != end:
            self.buffer.delete(self._iter(start), self._iter(end))
        self.buffer.insert(self._iter(start), replacement)
        self.buffer.end_user_action()
        if select:
            inserted_end = start + len(replacement)
            a = max(start, min(inserted_end, start + select[0]))
            b = max(start, min(inserted_end, start + select[1]))
            self.buffer.select_range(self._iter(b), self._iter(a))
        else:
            self.buffer.place_cursor(self._iter(start + len(replacement)))
        self.view.scroll_mark_onscreen(self.buffer.get_insert())

    def _read_clipboard(self, callback):
        def finish(clipboard, result):
            try:
                text = clipboard.read_text_finish(result)
            except GLib.Error:
                text = None
            callback(text)

        self.get_clipboard().read_text_async(None, finish)

    def wrap_selection(self, before, after):
        self.set_mode("edit" if self.mode == "preview" else self.mode)
        self.view.grab_focus()
        start, end = self._selection()
        selected = self.text()[start:end]
        # already wrapped: unwrap, so the shortcut toggles like in other editors
        text = self.text()
        if selected.startswith(before) and selected.endswith(after) and len(selected) >= len(before + after):
            self.replace_range(start, end, selected[len(before):len(selected) - len(after)],
                               (0, len(selected) - len(before) - len(after)))
            return
        if text[max(0, start - len(before)):start] == before and text[end:end + len(after)] == after:
            self.replace_range(start - len(before), end + len(after), selected, (0, len(selected)))
            return
        self.replace_range(start, end, before + selected + after, (len(before), len(before) + len(selected)))

    def insert_link(self):
        start, end = self._selection()
        selected = self.text()[start:end]

        def insert(clipboard_text):
            url = normalized_link_url(clipboard_text or "")
            label = escape_link_text(selected or "link text")
            markdown = f"[{label}]({escape_link_destination(url or 'https://')})"
            if not selected:
                self.replace_range(start, end, markdown, (1, 1 + len(label)))
            elif not url:
                self.replace_range(start, end, markdown, (len(label) + 3, len(markdown) - 1))
            else:
                self.replace_range(start, end, markdown)

        self.view.grab_focus()
        self._read_clipboard(insert)

    def paste(self):
        """Pasting a URL over selected text makes it a link; anything else pastes as plain text."""
        if not self.view.has_focus():
            focus = self.get_focus()
            if isinstance(focus, Gtk.Text):
                focus.emit("paste-clipboard")
            return
        start, end = self._selection()

        def insert(clipboard_text):
            if not clipboard_text:
                return
            url = normalized_link_url(clipboard_text) if start != end and is_markdown(self.current.path) else ""
            if url:
                selected = self.text()[start:end]
                leading = re.match(r"\s*", selected).group()
                trailing = selected[len(selected.rstrip()):]
                link_text = selected[len(leading):len(selected) - len(trailing)]
                if link_text:
                    self.replace_range(start, end, f"{leading}[{escape_link_text(link_text)}]"
                                                   f"({escape_link_destination(url)}){trailing}")
                    return
            self.replace_range(start, end, clipboard_text)

        self._read_clipboard(insert)

    def _line_bounds(self):
        """Offsets of the start of the first and the end of the last selected line."""
        start, end = self._selection()
        text = self.text()
        line_start = text.rfind("\n", 0, start) + 1
        line_end = text.find("\n", end)
        return line_start, len(text) if line_end < 0 else line_end

    def continue_list(self):
        """Return in a list item starts the next item; Return on an empty item ends the list.
        Everywhere else it's a plain newline (returns False and lets the text view insert it)."""
        if not is_markdown(self.current.path) or self.buffer.get_has_selection():
            return False
        text = self.text()
        cursor = self._cursor()
        line_start = text.rfind("\n", 0, cursor) + 1
        line_end = text.find("\n", cursor)
        line_end = len(text) if line_end < 0 else line_end
        if len(re.findall(r"^\s*(```|~~~)", text[:cursor], re.MULTILINE)) % 2 == 1:
            return False
        item = re.match(r"^(\s*)([-+*]|\d+[.)]|>)(\s+)(\[[ xX]\]\s+)?(.*)$", text[line_start:line_end])
        if not item or cursor < line_start + item.start(5) and cursor != line_end:
            return False
        if not item.group(5).strip() and cursor == line_end:
            self.replace_range(line_start, line_end, "")  # an empty item ends the list
            return True
        marker = item.group(2)
        if marker[0].isdigit():
            marker = f"{int(marker[:-1]) + 1}{marker[-1]}"
        task = "[ ] " if item.group(4) else ""
        self.replace_range(cursor, cursor, f"\n{item.group(1)}{marker}{item.group(3)}{task}")
        return True

    def indent_list_item(self, direction):
        """Tab and Shift+Tab indent list items; elsewhere Tab inserts a tab as usual."""
        if not is_markdown(self.current.path):
            return False
        start, end = self._line_bounds()
        lines = self.text()[start:end].split("\n")
        if not all(re.match(r"^\s*([-+*]|\d+[.)])\s", line) for line in lines if line.strip()):
            return direction < 0  # swallow Shift+Tab outside lists, let Tab through
        if direction > 0:
            new = ["  " + line if line.strip() else line for line in lines]
        else:
            new = [re.sub(r"^ {1,2}|^\t", "", line) for line in lines]
        joined = "\n".join(new)
        if joined != "\n".join(lines):
            cursor_shift = len(new[0]) - len(lines[0])
            cursor = self._cursor()
            self.replace_range(start, end, joined)
            if start == end or len(lines) == 1:
                self.buffer.place_cursor(self._iter(max(start, cursor + cursor_shift)))
        return True

    def prefix_lines(self, prefix):
        self.set_mode("edit" if self.mode == "preview" else self.mode)
        start, end = self._line_bounds()
        lines = self.text()[start:end].split("\n")
        pattern = r"^(\s*)(?:[-+*]\s+\[[ xX]\]\s+|[-+*]\s+|\d+[.)]\s+|>\s?)"
        stripped = [re.sub(pattern, r"\1", line) for line in lines]
        if all(line.lstrip().startswith(prefix.strip()) for line in lines if line.strip()) and prefix != "1. ":
            new = stripped  # toggle off
        elif prefix == "1. ":
            new = [re.sub(r"^(\s*)", rf"\g<1>{n + 1}. ", line) for n, line in enumerate(stripped)]
        else:
            new = [re.sub(r"^(\s*)", rf"\g<1>{prefix}", line) for line in stripped]
        self.replace_range(start, end, "\n".join(new))
        self.view.grab_focus()

    def set_heading(self, level):
        self.set_mode("edit" if self.mode == "preview" else self.mode)
        start, end = self._line_bounds()
        line = self.text()[start:end].split("\n")[0]
        end = start + len(line)
        current = re.match(r"^(#{1,6})\s+", line)
        body = line[current.end():] if current else line
        new = body if current and len(current.group(1)) == level else "#" * level + " " + body
        self.replace_range(start, end, new)
        self.view.grab_focus()

    # ----- documents -----

    def document_changed(self, doc, edited=False):
        if doc is not self.current:
            self.sidebar.refresh_documents(self.documents, self.current)
            return
        if edited:
            self.debounce("words", 150, self._update_words)
            if self.mode != "edit":
                self.debounce("preview", 250, self.refresh_preview)
            if self.search_open:
                self.debounce("search", 80, lambda: self.update_search(keep_position=True))
            self._update_placeholder()
        self._update_title()
        self.debounce("sidebar", 50, lambda: self.sidebar.refresh_documents(self.documents, self.current))
        self.save_session_soon()

    def _update_title(self):
        doc = self.current
        if not doc:
            return
        name = doc.name() if doc.path else "Untitled"
        self.set_title(("• " if doc.modified else "") + name + " - Walwrite")
        if doc.status:
            status = doc.status
        elif doc.path:
            status = short_path(doc.path) + ("  ·  saving…" if doc.modified else "")
        else:
            status = "Not saved yet" if doc.buffer.get_char_count() else ""
        self.status_label.set_text(status)
        self.status_label.set_tooltip_text(short_path(doc.path) if doc.path else None)

    def _update_words(self):
        if self.current:
            count = count_words(self.text())
            self.words_label.set_text(f"{count} word" if count == 1 else f"{count} words")

    def _place_placeholder(self):
        self.placeholder.set_margin_start(self.view.get_left_margin())
        self.placeholder.set_margin_top(self.view.get_top_margin())

    def _update_placeholder(self):
        show = bool(self.current and self.current.buffer.get_char_count() == 0
                    and not self.view.has_focus() and self.mode != "preview")
        self.placeholder.set_visible(show)
        return False

    def add_document(self, doc, show=True):
        self.documents.append(doc)
        if show:
            self.show_document(doc)
        else:
            self.sidebar.refresh_documents(self.documents, self.current)
        return doc

    def new_document(self, show=True):
        return self.add_document(Document(self, self.tag_table), show)

    def show_document(self, doc):
        if doc not in self.documents:
            return
        if self.current is not None and self.current is not doc:
            self.current.scroll = self.scroller.get_vadjustment().get_value()
            self.current.autosave()
        self.current = doc
        self.view.set_buffer(doc.buffer)
        self.view.set_editable(True)
        self.buffer.place_cursor(self._iter(min(doc.cursor, doc.buffer.get_char_count())))
        GLib.idle_add(lambda: self.scroller.get_vadjustment().set_value(doc.scroll) or False)
        if self.search_open:
            self.update_search()
        self._update_words()
        self._update_placeholder()
        self._update_title()
        if doc.path:
            self.sidebar.set_folder(self.sidebar.folder or os.path.dirname(doc.path))
        self.sidebar.refresh_documents(self.documents, doc)
        if self.mode != "edit":
            self.refresh_preview()
        self.view.grab_focus()
        self.save_session_soon()

    def find_document(self, path):
        path = os.path.realpath(path)
        return next((d for d in self.documents if d.path and os.path.realpath(d.path) == path), None)

    def open_path(self, path):
        """Show path, opening it in a new document unless it's already open. Returns the document."""
        existing = self.app.find_open(path)
        if existing:
            window, doc = existing
            window.show_document(doc)
            window.present()
            return doc
        if not os.path.exists(path):
            self.current and self.current.set_status(f"{short_path(path)} doesn't exist")
            return None
        # replace an untouched empty document instead of piling up untitled ones
        blank = self.current if self.current and self.current.is_empty_untitled() else None
        doc = Document(self, self.tag_table)
        if not doc.load(path):
            if self.current:
                self.current.set_status(doc.status)
            return None
        if blank:
            index = self.documents.index(blank)
            self.documents[index] = doc
            blank.dispose()
            blank.clear_draft()
            self.show_document(doc)
        else:
            self.add_document(doc)
        doc.set_status(f"Opened {doc.name()}")
        self.app.remember_recent(doc.path)
        return doc

    def close_document(self, doc=None, then=None):
        doc = doc or self.current
        if doc is None:
            return

        def really_close():
            doc.dispose()
            doc.clear_draft()
            index = self.documents.index(doc)
            self.documents.remove(doc)
            if not self.documents:
                self.new_document(show=False)
            if doc is self.current:
                self.current = None
                self.show_document(self.documents[min(index, len(self.documents) - 1)])
            else:
                self.sidebar.refresh_documents(self.documents, self.current)
            self.save_session_soon()
            if then:
                then()

        if doc.path and doc.modified:
            doc.autosave()
        if not doc.modified or (doc.path and not doc.modified):
            really_close()
            return
        if not doc.path and not doc.text().strip():
            really_close()
            return
        self.show_document(doc)

        def respond(response):
            if response == "save":
                self.save(doc, then=really_close)
            elif response == "discard":
                really_close()

        choice_dialog(self, "Unsaved document", f"Save {doc.name()} before closing it?",
                      [("Cancel", "cancel", False, True), ("Don't Save", "discard", False, True),
                       ("Save", "save", True, True)], respond, focus="save")

    def cycle_document(self, step):
        if len(self.documents) > 1 and self.current in self.documents:
            index = (self.documents.index(self.current) + step) % len(self.documents)
            self.show_document(self.documents[index])

    def _on_focus_change(self):
        # save when leaving the window, like most editors with autosave
        if not self.is_active() and self.current:
            for doc in self.documents:
                doc.autosave()
        self._update_placeholder()

    # ----- files -----

    def _file_dialog(self, title):
        dialog = Gtk.FileDialog(title=title, modal=True)
        filters = Gio.ListStore.new(Gtk.FileFilter)
        text = Gtk.FileFilter(name="Markdown and text files")
        for pattern in TEXT_FILES:
            text.add_suffix(pattern.lstrip("."))
        everything = Gtk.FileFilter(name="All files")
        everything.add_pattern("*")
        filters.append(text)
        filters.append(everything)
        dialog.set_filters(filters)
        dialog.set_default_filter(text)
        folder = (os.path.dirname(self.current.path) if self.current and self.current.path
                  else self.sidebar.folder or read_settings().get("last_save_dir") or os.path.expanduser("~"))
        if os.path.isdir(folder):
            dialog.set_initial_folder(Gio.File.new_for_path(folder))
        return dialog

    def open_dialog(self):
        dialog = self._file_dialog("Open")

        def finish(dialog, result):
            try:
                files = dialog.open_multiple_finish(result)
            except GLib.Error:
                return
            for index in range(files.get_n_items()):
                path = files.get_item(index).get_path()
                if path:
                    self.open_path(path)

        dialog.open_multiple(self, None, finish)

    def open_folder_dialog(self):
        dialog = Gtk.FileDialog(title="Open Folder", modal=True)
        if self.sidebar.folder:
            dialog.set_initial_folder(Gio.File.new_for_path(self.sidebar.folder))

        def finish(dialog, result):
            try:
                folder = dialog.select_folder_finish(result)
            except GLib.Error:
                return
            if folder and folder.get_path():
                self.sidebar.set_folder(folder.get_path())
                self.sidebar_revealer.set_reveal_child(True)
                update_settings(folder=folder.get_path())
                self.save_session_soon()

        dialog.select_folder(self, None, finish)

    def save(self, doc=None, then=None):
        doc = doc or self.current
        if doc.path:
            if doc.save_to(doc.path) and then:
                then()
        else:
            self.save_as(doc, then)

    def save_as(self, doc=None, then=None, title="Save As"):
        doc = doc or self.current
        dialog = self._file_dialog(title)
        dialog.set_initial_name(os.path.basename(doc.path) if doc.path else suggested_file_name(doc.text()))

        def finish(dialog, result):
            try:
                file = dialog.save_finish(result)
            except GLib.Error:
                return
            if file and file.get_path():
                old = doc.path
                if doc.save_to(file.get_path()):
                    update_settings(last_save_dir=os.path.dirname(doc.path))
                    self.app.remember_recent(doc.path)
                    if title == "Rename" and old and os.path.realpath(old) != os.path.realpath(doc.path):
                        try:
                            os.remove(old)
                        except OSError:
                            pass
                    if then:
                        then()

        dialog.save(self, None, finish)

    def rename(self):
        if not self.current.path:
            self.save_as()
        else:
            self.save_as(title="Rename")

    # ----- preview -----

    def set_mode(self, mode):
        if mode == self.mode:
            return
        self.mode = mode
        self.scroller.set_visible(mode != "preview")
        self.preview.set_visible(mode != "edit")
        if mode == "split":
            GLib.idle_add(lambda: self.panes.set_position(self.panes.get_width() // 2) or False)
        if mode != "edit":
            self.refresh_preview()
        if mode != "preview":
            self.view.grab_focus()
        self._sync_toggles()
        self._update_placeholder()
        self.save_session_soon()

    def refresh_preview(self):
        if self.current and self.mode != "edit":
            self.preview.render(self.current, self.palette, self.font_size)

    def toggle_sidebar(self):
        self.sidebar_revealer.set_reveal_child(not self.sidebar_revealer.get_reveal_child())
        update_settings(sidebar=self.sidebar_revealer.get_reveal_child())
        self.save_session_soon()

    def _sync_toggles(self):
        for button, on in ((self.sidebar_button, self.sidebar_revealer.get_reveal_child()),
                           (self.preview_button, self.mode != "edit")):
            (button.add_css_class if on else button.remove_css_class)("on")

    # ----- search -----

    def open_search(self, replace):
        self.set_mode("edit" if self.mode == "preview" else self.mode)
        self.search_open = True
        self.search_pane.set_visible(True)
        for widget in (self.replace_entry, self.replace_button, self.replace_all_button):
            widget.set_visible(replace)
        start, end = self._selection()
        selected = self.text()[start:end]
        if selected and "\n" not in selected:
            self.find_entry.set_text(selected)
        self.find_entry.grab_focus()
        self.find_entry.select_region(0, -1)
        self.update_search()

    def close_search(self):
        self.search_open = False
        self.search_pane.set_visible(False)
        self.search_matches, self.search_index = [], -1
        self._show_search_tags(select=False)
        self.view.grab_focus()

    def update_search(self, keep_position=False):
        query = self.find_entry.get_text()
        text = self.text()
        self.search_matches = [m.start() for m in re.finditer(re.escape(query), text, re.IGNORECASE)] if query else []
        if keep_position and self.search_matches:
            self.search_index = min(max(self.search_index, 0), len(self.search_matches) - 1)
        elif self.search_matches:
            cursor = self._selection()[0]
            self.search_index = next((i for i, m in enumerate(self.search_matches) if m >= cursor), 0)
        else:
            self.search_index = -1
        self._show_search_tags(select=not keep_position)

    def _show_search_tags(self, select=True):
        for doc in self.documents:
            start, end = doc.buffer.get_bounds()
            doc.buffer.remove_tag_by_name("search", start, end)
            doc.buffer.remove_tag_by_name("current-search", start, end)
        if not self.search_open:
            return
        length = len(self.find_entry.get_text())
        for index, match in enumerate(self.search_matches):
            name = "current-search" if index == self.search_index else "search"
            self.buffer.apply_tag_by_name(name, self._iter(match), self._iter(match + length))
        total = len(self.search_matches)
        self.count_label.set_text(f"{self.search_index + 1}/{total}" if total else "0/0")
        if select and self.search_index >= 0:
            match = self.search_matches[self.search_index]
            self.buffer.select_range(self._iter(match + length), self._iter(match))
            self.view.scroll_to_mark(self.buffer.get_insert(), 0.2, False, 0, 0)

    def move_search(self, direction):
        if self.search_matches:
            self.search_index = (self.search_index + direction) % len(self.search_matches)
            self._show_search_tags()

    def replace_current(self):
        if self.search_index < 0:
            return
        start = self.search_matches[self.search_index]
        self.replace_range(start, start + len(self.find_entry.get_text()), self.replace_entry.get_text())
        self.update_search(keep_position=True)
        self._show_search_tags()

    def replace_all(self):
        length = len(self.find_entry.get_text())
        if not length or not self.search_matches:
            return
        count = len(self.search_matches)
        self.buffer.begin_user_action()
        for start in reversed(self.search_matches):
            self.buffer.delete(self._iter(start), self._iter(start + length))
            self.buffer.insert(self._iter(start), self.replace_entry.get_text())
        self.buffer.end_user_action()
        self.update_search()
        self.current.set_status(f"Replaced {count} match{'es' if count != 1 else ''}")

    def _on_find_key(self, _controller, keyval, _keycode, state):
        if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            self.move_search(-1 if state & Gdk.ModifierType.SHIFT_MASK else 1)
            return True
        if keyval == Gdk.KEY_Escape:
            self.close_search()
            return True
        return False

    def _on_replace_key(self, _controller, keyval, _keycode, _state):
        if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            self.replace_current()
            return True
        if keyval == Gdk.KEY_Escape:
            self.close_search()
            return True
        return False


    # ----- printing and dialogs -----

    def print_document(self):
        try:
            gi.require_foreign("cairo")
            gi.require_version("PangoCairo", "1.0")
            from gi.repository import PangoCairo
        except (ImportError, ValueError):
            self.current.set_status("Printing needs python3-cairo")
            return
        markup = markdown_to_pango(self.text()) if is_markdown(self.current.path) else escape_markup(self.text())
        state = {}
        operation = Gtk.PrintOperation(job_name=self.current.name())

        def begin(operation, context):
            layout = context.create_pango_layout()
            layout.set_font_description(Pango.FontDescription.from_string(f"{FONT_FAMILY} 10"))
            layout.set_width(int(context.get_width() * Pango.SCALE))
            layout.set_wrap(Pango.WrapMode.WORD_CHAR)
            layout.set_markup(markup, -1)
            page_height = context.get_height() * Pango.SCALE
            pages, top, lines = [], 0, layout.get_iter()
            while True:
                logical = lines.get_line_extents()[1]
                if logical.y + logical.height - top > page_height and logical.y > top:
                    pages.append((top, logical.y))
                    top = logical.y
                if not lines.next_line():
                    break
            pages.append((top, layout.get_extents()[1].height))
            state.update(layout=layout, pages=pages)
            operation.set_n_pages(len(pages))

        def draw(_operation, context, page):
            top, bottom = state["pages"][page]
            cr = context.get_cairo_context()
            cr.rectangle(0, 0, context.get_width(), (bottom - top) / Pango.SCALE)
            cr.clip()
            cr.move_to(0, -top / Pango.SCALE)
            PangoCairo.show_layout(cr, state["layout"])

        operation.connect("begin-print", begin)
        operation.connect("draw-page", draw)
        try:
            operation.run(Gtk.PrintOperationAction.PRINT_DIALOG, self)
        except GLib.Error as error:
            self.current.set_status(f"Could not print: {error.message}")

    def show_shortcuts(self):
        width = max(len(keys) for keys, _ in SHORTCUTS) + 3
        body = "\n".join(f"{keys:<{width}}{description}" for keys, description in SHORTCUTS)
        choice_dialog(self, "Keyboard shortcuts", body, [("Close", "close", True, True)],
                      lambda _r: None, focus="close")

    def show_about(self):
        preview = "WebKitGTK" if WebKit else "plain GTK (install webkitgtk6.0 for full rendering)"
        renderer = "python-markdown" if python_markdown else "built-in"
        choice_dialog(self, "Walwrite", "A simple Markdown and text editor in the pywal colors.\n\n"
                      f"Preview: {preview}\nMarkdown: {renderer}\nDrafts and session: {short_path(STATE_DIR)}",
                      [("Close", "close", True, True)], lambda _r: None, focus="close")

    # ----- session and closing -----

    def state(self):
        docs = []
        for doc in self.documents:
            if doc.is_empty_untitled() and len(self.documents) > 1:
                continue
            if doc.modified:
                doc.write_draft()
            scroll = self.scroller.get_vadjustment().get_value() if doc is self.current else doc.scroll
            docs.append({"path": doc.path, "draft": doc.draft_id if doc.modified or not doc.path else None,
                         "cursor": doc.cursor, "scroll": scroll})
        current = self.documents.index(self.current) if self.current in self.documents else 0
        return {"documents": docs, "current": current, "mode": self.mode,
                "sidebar": self.sidebar_revealer.get_reveal_child(), "folder": self.sidebar.folder,
                "width": self.get_width() or None, "height": self.get_height() or None,
                "maximized": self.is_maximized(), "font_size": self.font_size}

    def restore(self, state):
        for entry in state.get("documents", []):
            path, draft = entry.get("path"), entry.get("draft")
            doc = Document(self, self.tag_table, path=path, draft_id=draft)
            if draft and doc.restore_draft():
                pass
            elif path and os.path.exists(path):
                if not doc.load(path):
                    continue
            else:
                continue
            doc.cursor = entry.get("cursor", 0)
            doc.scroll = entry.get("scroll", 0.0)
            doc.status = ""
            self.documents.append(doc)
        if not self.documents:
            self.new_document(show=False)
        index = min(max(state.get("current", 0), 0), len(self.documents) - 1)
        self.show_document(self.documents[index])
        if state.get("mode") in ("preview", "split"):
            self.set_mode(state["mode"])

    def save_session_soon(self):
        if not self.closing:
            self.app.save_session_soon()

    def _on_close_request(self, _window):
        # everything is kept: saved files are autosaved and untitled text stays a draft,
        # so closing never asks; the documents come back next time
        for doc in self.documents:
            doc.autosave()
        if not self.is_maximized() and not self.is_fullscreen():
            update_settings(width=self.get_width(), height=self.get_height())
        self.app.window_closing(self)
        self.closing = True
        for doc in self.documents:
            doc.dispose()
        return False


# ---------- app ----------

class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_OPEN)
        self.windows = []
        self.closed_states = []  # windows closed earlier this run, in case the last one closes after them
        self._session_source = 0
        self._lock = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        GLib.set_application_name("Walwrite")
        for name, callback in (("new-window", self.new_window), ("quit", self.quit_all)):
            action = Gio.SimpleAction.new(name, None)
            action.connect("activate", lambda _a, _p, c=callback: c())
            self.add_action(action)
        for action, accels in ACCELS.items():
            if action not in ("win.cut", "win.copy", "win.select-all", "win.paste"):
                self.set_accels_for_action(action, accels)
        os.makedirs(DRAFTS_DIR, exist_ok=True)
        self._migrate_old_recovery()

    def do_activate(self):
        if self.windows:
            self.windows[-1].present()
            return
        self.restore_session()

    def do_open(self, files, _n_files, _hint):
        if not self.windows:
            self.restore_session()
        window = self.get_active_window() or self.windows[-1]
        for file in files:
            path = file.get_path()
            if path:
                if not os.path.exists(path):
                    try:  # `walwrite notes.md` for a new file creates it, like other editors
                        open(path, "a").close()
                    except OSError:
                        continue
                window.open_path(path)
        window.present()

    def restore_session(self):
        session = read_json(SESSION_FILE, {})
        states = [s for s in session.get("windows", []) if isinstance(s, dict)] or [{}]
        for state in states:
            window = WriterWindow(self, state)
            self.windows.append(window)
            window.restore(state)
            window.present()

    def new_window(self):
        window = WriterWindow(self, {"sidebar": False})
        self.windows.append(window)
        window.new_document()
        window.present()
        self.save_session_soon()

    def find_open(self, path):
        for window in self.windows:
            doc = window.find_document(path)
            if doc:
                return window, doc
        return None

    def remember_recent(self, path):
        recent = [p for p in read_settings().get("recent", []) if p != path]
        update_settings(recent=[path] + recent[:19])

    def save_session_soon(self):
        if self._session_source:
            GLib.source_remove(self._session_source)
        self._session_source = GLib.timeout_add(400, self._save_session)

    def _save_session(self):
        self._session_source = 0
        states = [w.state() for w in self.windows if not w.closing]
        if states:
            write_json(SESSION_FILE, {"windows": states, "saved": time.time()})
            self._clean_drafts(states)
        return False

    def window_closing(self, window):
        state = window.state()
        others = [w for w in self.windows if w is not window and not w.closing]
        if others:
            # closing one of several windows: its files close with it, and untitled text moves
            # to a remaining window so it isn't lost
            moved =[d for d in window.documents if not d.path and d.modified and d.text().strip()]
            if moved:
                target = others[-1]
                for doc in moved:
                    copy = Document(target, target.tag_table, draft_id=doc.draft_id)
                    copy.set_text(doc.text(), modified=True)
                    copy.write_draft()
                    target.add_document(copy, show=False)
            self.windows.remove(window)
            self.save_session_soon()
        else:
            if self._session_source:
                GLib.source_remove(self._session_source)
                self._session_source = 0
            write_json(SESSION_FILE, {"windows": [state], "saved": time.time()})
            self._clean_drafts([state])
            self.windows.remove(window)

    def quit_all(self):
        if self.windows:
            states = [w.state() for w in self.windows]
            write_json(SESSION_FILE, {"windows": states, "saved": time.time()})
            self._clean_drafts(states)
            for window in list(self.windows):
                for doc in window.documents:
                    doc.autosave()
                    doc.dispose()
                window.closing = True
            self.windows.clear()
        self.quit()

    @staticmethod
    def _clean_drafts(states):
        keep = {d.get("draft") for s in states for d in s.get("documents", []) if d.get("draft")}
        try:
            names = os.listdir(DRAFTS_DIR)
        except OSError:
            return
        for name in names:
            if name.endswith(".json") and name[:-5] not in keep:
                path = os.path.join(DRAFTS_DIR, name)
                # a draft another running walwrite might still own is left alone for a day
                if time.time() - os.path.getmtime(path) > 86400 or not keep:
                    try:
                        os.remove(path)
                    except OSError:
                        pass

    @staticmethod
    def _migrate_old_recovery():
        """Walwrite used to keep one recovery-N.json per window; turn those into session drafts."""
        try:
            names = [n for n in os.listdir(STATE_DIR) if re.match(r"recovery-\d+\.(json|lock)$", n)]
        except OSError:
            return
        if not names:
            return
        session = read_json(SESSION_FILE, {})
        windows = session.get("windows") or [{"documents": []}]
        for name in names:
            path = os.path.join(STATE_DIR, name)
            if name.endswith(".json"):
                data = read_json(path, {})
                if isinstance(data.get("text"), str) and data["text"].strip():
                    draft_id = uuid.uuid4().hex
                    write_json(os.path.join(DRAFTS_DIR, draft_id + ".json"), data)
                    windows[0].setdefault("documents", []).append(
                        {"path": data.get("file") or None, "draft": draft_id, "cursor": 0, "scroll": 0})
            try:
                os.remove(path)
            except OSError:
                pass
        session["windows"] = windows
        write_json(SESSION_FILE, session)


def main():
    GLib.set_prgname(APP_NAME)  # the Wayland app_id that sway's floating rule matches
    Gtk.Window.set_default_icon_name("accessories-text-editor")
    args = []
    for arg in sys.argv[1:]:
        if arg.startswith("file://"):
            arg = Gio.File.new_for_uri(arg).get_path() or arg
        if not arg.startswith("-"):
            args.append(os.path.abspath(arg))
    return App().run([sys.argv[0]] + args)


if __name__ == "__main__":
    sys.exit(main())
