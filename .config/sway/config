# Sway config ported from ~/Downloads/dotfiles-2026/.config/hypr/hyprland.lua
# Reload with $mod+Shift+c. See `man 5 sway`.

##############
### COLORS ###
##############

# Fallback palette (wpg scheme: garden-at-arles), overridden by pywal's
# generated colors. Run `wal.sh IMAGE` to change them.
include ~/.config/sway/colors
include ~/.cache/wal/colors-sway

###################
### MY PROGRAMS ###
###################

set $mod Mod4
set $terminal kitty
set $fileManager nautilus
# sway gives apps a PATH without ~/.local/bin, so add it for everything the launcher starts
set $menu env PATH="$HOME/.local/bin:$PATH" fuzzel
# saved to ~/Screenshots and copied; click the notification to mark it up
set $screenshot ~/.local/bin/screenshot.sh
set $lock swaylock -f

###############
### OUTPUTS ###
###############

# 1536x960 logical. Closest to macOS "looks like 1440x900" that divides the
# 2560x1600 panel evenly; 1.775 left the bottom pixel row undrawn (glitchy line).
output eDP-1 scale 1.66667
output * bg ~/wallpapers/wallhaven-mpgko1_1920x1080.png fill

#################
### AUTOSTART ###
#################

exec /usr/libexec/polkit-mate-authentication-agent-1
exec swaync
exec swayosd-server
# split new windows along the focused window's longer side (1 | top/bottom instead of 1 | 1 | 1)
exec ~/.local/bin/autotiling
# sway decides what closing the lid does (lid.sh), not logind
exec ~/.local/bin/lid.sh inhibit
# clipboard history (Super+Ctrl+V)
exec ~/.local/bin/clipboard-history.py watch
# timers and reminders set before logging out
exec ~/.local/bin/timer.py resume
# the battery charge limit from the settings panel (it resets on boot)
exec sh -c 'f=~/.local/state/battery-limit; [ -f "$f" ] && for t in /sys/class/power_supply/*/charge_control_end_threshold; do cat "$f" > "$t"; done'

# seconds idle before locking, turning the screen off, and suspending (0 = never).
# idle.sh starts swayidle with these at the end of this file, after settings.conf can change them.
set $idle_lock 300
set $idle_screen_off 330
set $idle_suspend 1800
# closing the lid: sleep, lock, or nothing (lid.sh; set in Settings > lock & sleep)
set $lid_action sleep

#####################
### LOOK AND FEEL ###
#####################

font pango:BlexMono Nerd Font 10

# Sway puts `inner` between windows and `outer + inner` at screen edges,
# so this gives Hyprland's 10px between windows and 5px at the edges
gaps inner 10
gaps outer -5

default_border pixel 1
default_floating_border pixel 1

# class                 border  bg      text        indicator child_border
client.focused          $color4 $color4 $background $color4   $color4
client.focused_inactive $color0 $color0 $foreground $color0   $color0
client.unfocused        $color0 $color0 $foreground $color0   $color0
client.urgent           $color3 $color3 $background $color3   $color3

#############
### INPUT ###
#############

input type:keyboard {
    xkb_layout us
}

input type:pointer {
    accel_profile flat
    pointer_accel 0
}

input type:touchpad {
    natural_scroll enabled
    pointer_accel 0.3
    scroll_factor 0.54
}

focus_follows_mouse yes

seat seat0 xcursor_theme BreezeX-RosePine-Linux 24

###################
### KEYBINDINGS ###
###################

# macOS-style copy/cut/paste/select all. Sends Ctrl+<key> to apps and
# Ctrl+Shift+C/V to terminals (Cmd+X/Cmd+A do nothing in terminals).
bindsym $mod+c exec ~/.local/bin/mac-clipboard.sh c
bindsym $mod+x exec ~/.local/bin/mac-clipboard.sh x
bindsym $mod+v exec ~/.local/bin/mac-clipboard.sh v
bindsym $mod+a exec ~/.local/bin/mac-clipboard.sh a

bindsym $mod+q exec $terminal
bindsym --no-repeat $mod+w exec ~/.local/bin/close-window.py
bindsym $mod+m exit
bindsym $mod+e exec $fileManager
bindsym $mod+Shift+v floating toggle
bindsym $mod+r exec $menu
# Spotlight: apps, files, settings, commands, math (press again to close)
bindsym $mod+space exec ~/.local/bin/spotlight.py
# clipboard history picker
bindsym $mod+Ctrl+v exec ~/.local/bin/clipboard-history.py pick
# emoji picker, like Ctrl+Cmd+Space on macOS
bindsym $mod+Ctrl+space exec ~/.local/bin/emoji-picker.py
# copy the color of any pixel on screen
bindsym $mod+Shift+p exec ~/.local/bin/color-picker.sh
# every shortcut, grouped (press any key to close)
bindsym $mod+slash exec ~/.local/bin/cheatsheet.py
bindsym $mod+n exec swaync-client -t -sw
# settings popup, like Cmd+, on macOS (press again to close)
bindsym $mod+comma exec ~/.local/bin/settings-panel.py
# wallpaper grid (~/wallpapers and the dharmx/walls gallery), re-themes with wal.sh (press again to close)
bindsym $mod+p exec ~/.local/bin/wallpaper-picker.py
bindsym $mod+j layout toggle split
bindsym $mod+f exec firefox
# calculator and Markdown writer, on Omarchy's keys
bindsym $mod+Ctrl+q exec ~/.local/bin/walcalc
bindsym XF86Calculator exec ~/.local/bin/walcalc
bindsym $mod+Shift+w exec ~/.local/bin/walwrite
bindsym $mod+g fullscreen
bindsym $mod+Shift+c reload

bindsym $mod+k exec $screenshot window
bindsym $mod+l exec $screenshot output
bindsym $mod+Shift+k exec $screenshot area

# Move focus with mod + arrow keys
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Special workspace "magic" -> scratchpad
bindsym $mod+s scratchpad show
bindsym $mod+Shift+s move scratchpad

# Scroll through workspaces with mod + scroll
bindsym --whole-window $mod+button5 workspace next_on_output
bindsym --whole-window $mod+button4 workspace prev_on_output

# Trackpad gestures (change them in Settings > trackpad)
bindgesture swipe:3:left workspace next_on_output
bindgesture swipe:3:right workspace prev_on_output
bindgesture swipe:4:left move container to workspace next_on_output, workspace next_on_output
bindgesture swipe:4:right move container to workspace prev_on_output, workspace prev_on_output

# Move/resize windows with mod + left/right drag
floating_modifier $mod normal

# Keyboard resizing, since right-drag is awkward on a trackpad
mode "resize" {
    bindsym Left resize shrink width 20px
    bindsym Down resize grow height 20px
    bindsym Up resize shrink height 20px
    bindsym Right resize grow width 20px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+Shift+r mode "resize"

# Laptop function keys
# Volume and brightness show a macOS-style popup (swayosd)
bindsym --locked XF86AudioMute exec swayosd-client --output-volume mute-toggle
bindsym --locked XF86AudioLowerVolume exec swayosd-client --output-volume lower
bindsym --locked XF86AudioRaiseVolume exec swayosd-client --output-volume raise --max-volume 100
bindsym --locked XF86AudioMicMute exec swayosd-client --input-volume mute-toggle
bindsym --locked XF86MonBrightnessDown exec swayosd-client --brightness lower
bindsym --locked XF86MonBrightnessUp exec swayosd-client --brightness raise
# Keyboard backlight: the M1 Air has no keys for it, so use F3 (mission control) / F4 (search)
bindsym --locked XF86LaunchA exec swayosd-client --device kbd_backlight --brightness lower --min-brightness 0
bindsym --locked XF86Search exec swayosd-client --device kbd_backlight --brightness raise
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous

###################
### WINDOWRULES ###
###################

for_window [title="^Rename .+"] floating enable
for_window [app_id="org.kde.ark"] floating enable
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable, resize set 900 560
for_window [class="feh"] floating enable, resize set 80 ppt 80 ppt, move position center
for_window [app_id="walcalc"] floating enable
# settings and wallpaper picker: movable windows that stay open until closed
for_window [app_id="^dev\.dotfiles\.(SettingsPanel|WallpaperPicker)$"] floating enable, move position center
for_window [app_id="^dev\.dotfiles\.QuickLook$"] floating enable, move position center
for_window [app_id="^dev\.dotfiles\.Cheatsheet$"] floating enable, border none, move position center
# picture-in-picture video: floats in the bottom right corner and follows you across workspaces
for_window [app_id="^(firefox|org\.mozilla\.firefox)$" title="^Picture-in-Picture$"] floating enable, sticky enable, border none, resize set 480 270, move position 100 ppt 100 ppt, move left 496 px, move up 286 px
for_window [app_id="^dev\.dotfiles\.Spotlight$"] floating enable, border none, move position center, move up 180 px

###########
### BAR ###
###########

bar {
    swaybar_command waybar
}

include /etc/sway/config.d/*

# Unsaved changes from the settings panel (Super+,). They override anything above until
# they're saved into this file or discarded. Keep this near the end.
include ~/.config/sway/settings.conf

exec_always ~/.local/bin/idle.sh $idle_lock $idle_screen_off $idle_suspend
bindswitch --reload --locked lid:on exec ~/.local/bin/lid.sh close $lid_action
bindswitch --reload --locked lid:off exec ~/.local/bin/lid.sh open
