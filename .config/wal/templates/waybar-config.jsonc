{{
	"reload_style_on_change": true,
	"layer": "top",
	"position": "top",
	"height": 30,
	"spacing": 0,
	"modules-left": [
		"sway/workspaces",
		"sway/mode",
		"custom/now-playing"
	],
	"modules-center": [
		"custom/clock",
		"custom/timer",
		"custom/stay-awake",
		"custom/notification"
	],
	"modules-right": [
		"group/tray-expander",
		"custom/agents",
		"bluetooth",
		"network",
		"custom/tailscale",
		"custom/audio",
		"custom/battery"
	],
	"sway/workspaces": {{
		"disable-scroll": true,
		"format": "{{icon}}{{name}}",
		"format-icons": {{
			"default": " ",
			"urgent": "!",
			"focused": "*"
		}}
	}},
	"sway/mode": {{
		"format": "{{}}"
	}},
	"custom/clock": {{
		"format": "{{}}",
		"exec": "date +'%I:%M %p %A, %b %d' | tr '[:upper:]' '[:lower:]'",
		"interval": 3,
		"on-click": "swaync-client -t -sw",
		"tooltip": false
	}},
	"custom/now-playing": {{
		"exec": "~/.local/bin/now-playing.py",
		"return-type": "json",
		"restart-interval": 5,
		"on-click": "playerctl play-pause",
		"on-click-right": "playerctl next",
		"on-click-middle": "playerctl previous",
		"max-length": 45
	}},
	"custom/timer": {{
		"exec": "~/.local/bin/timer.py bar",
		"return-type": "json",
		"restart-interval": 5,
		"signal": 15,
		"on-click": "~/.local/bin/timer.py menu"
	}},
	"custom/weather": {{
		"exec": "~/.local/bin/sysinfo.py weather",
		"return-type": "json",
		"restart-interval": 60
	}},
	"custom/network-speed": {{
		"exec": "~/.local/bin/sysinfo.py net",
		"return-type": "json",
		"restart-interval": 10
	}},
	"custom/system": {{
		"exec": "~/.local/bin/sysinfo.py system",
		"return-type": "json",
		"restart-interval": 10,
		"on-click": "kitty --class btop -e btop"
	}},
	"custom/dexcom": {{
		"exec": "~/.local/bin/dexcom.sh bar",
		"return-type": "json",
		"interval": 300,
		"signal": 16,
		"on-click": "pkill -RTMIN+16 -x waybar"
	}},
	"custom/stay-awake": {{
		"exec": "~/.local/bin/stay-awake.sh status",
		"return-type": "json",
		"interval": 30,
		"signal": 14,
		"on-click": "~/.local/bin/stay-awake.sh off"
	}},
	"custom/notification": {{
		"exec": "swaync-client -swb",
		"return-type": "json",
		"format": "{{icon}}",
		"format-icons": {{
			"notification": "",
			"none": "",
			"inhibited-notification": "",
			"inhibited-none": "",
			"dnd-notification": "󰂛",
			"dnd-none": "󰂛",
			"dnd-inhibited-notification": "󰂛",
			"dnd-inhibited-none": "󰂛"
		}},
		"tooltip": false,
		"on-click": "swaync-client -d -sw"
	}},
	"group/tray-expander": {{
		"orientation": "inherit",
		"drawer": {{
			"transition-duration": 600,
			"children-class": "tray-group-item"
		}},
		"modules": ["custom/expand-icon", "tray"]
	}},
	"custom/expand-icon": {{
		"exec": "~/.local/bin/tray-status.py",
		"return-type": "json",
		"restart-interval": 5,
		"tooltip": false
	}},
	"tray": {{
		"icon-size": 15,
		"spacing": 17
	}},
	"bluetooth": {{
		"format": "",
		"format-off": "󰂲",
		"format-disabled": "󰂲",
		"format-connected": "󰂱",
		"format-no-controller": "",
		"tooltip-format": "devices connected: {{num_connections}}",
		"on-click": "~/.local/bin/bluetooth-menu.sh"
	}},
	"network": {{
		"format": "{{icon}}",
		"format-wifi": "{{icon}}",
		"format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
		"format-ethernet": "󰀂",
		"format-disconnected": "󰤮",
		"tooltip-format-wifi": "{{essid}} ({{signalStrength}}%)",
		"tooltip-format-ethernet": "connected",
		"tooltip-format-disconnected": "disconnected",
		"interval": 3,
		"on-click": "~/.local/bin/network-menu.sh"
	}},
	"custom/agents": {{
		"exec": "~/.local/bin/agent-usage.py bar",
		"return-type": "json",
		"interval": 30,
		"signal": 12,
		"on-click": "~/.local/bin/agent-usage.py menu",
		"on-click-right": "~/.local/bin/agent-usage.py refresh"
	}},
	"custom/tailscale": {{
		"exec": "~/.local/bin/tailscale-status.sh",
		"return-type": "json",
		"interval": 5,
		"signal": 11,
		"on-click": "~/.local/bin/tailscale-menu.sh"
	}},
	"custom/audio": {{
		"exec": "~/.local/bin/audio-status.py",
		"return-type": "json",
		"restart-interval": 2,
		"on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
		"on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
		"on-click": "~/.local/bin/audio-menu.sh",
		"on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
		"on-click-middle": "pavucontrol"
	}},
	"custom/battery": {{
		"exec": "~/.local/bin/battery-status.py",
		"return-type": "json",
		"interval": 20,
		"signal": 13,
		"on-click": "~/.local/bin/power-menu.sh",
		"on-click-right": "~/.local/bin/battery-status.py toggle"
	}}
}}
